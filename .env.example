# Local Docker development only. Use secret management and stronger credentials in production.
ASE_MYSQL_DATABASE=ai_software_engineer
ASE_MYSQL_USER=ase
ASE_MYSQL_PASSWORD=ase_local_change_me
ASE_MYSQL_ROOT_PASSWORD=ase_root_local_change_me
ASE_MYSQL_PORT=3307

# Runtime DSN. Percent-encode reserved characters in username/password.
ASE_MYSQL_DSN=mysql+pymysql://ase:ase_local_change_me@127.0.0.1:3307/ai_software_engineer

# HTTP providers are optional fallbacks. Never commit real values.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
