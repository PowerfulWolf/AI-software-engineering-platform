{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/context.schema.json",
  "title": "ContextBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_id", "task_id", "role", "attempt", "source_revision", "sections", "budget", "built_at"],
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uri", "sha256", "tokens", "content", "priority"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "tokens": {"type": "integer", "minimum": 0},
        "content": {"type": "string"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
        "truncated": {"type": "boolean", "default": false}
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "kind", "count"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_tokens", "reserved_output_tokens", "used_input_tokens"],
      "properties": {
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "reserved_output_tokens": {"type": "integer", "minimum": 0},
        "used_input_tokens": {"type": "integer", "minimum": 0}
      }
    }
  },
  "properties": {
    "context_id": {"type": "string", "pattern": "^ctx_[a-f0-9]{64}$"},
    "task_id": {"type": "string", "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$"},
    "role": {"enum": ["orchestrator", "coder", "qa", "reviewer"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 10},
    "source_revision": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
    "redactions": {"type": "array", "items": {"$ref": "#/$defs/redaction"}},
    "budget": {"$ref": "#/$defs/budget"},
    "built_at": {"type": "string", "format": "date-time"}
  }
}
