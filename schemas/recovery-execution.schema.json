      "properties": {
        "allowed_paths": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Paths",
          "type": "array"
        },
        "denied_paths": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Denied Paths",
          "type": "array"
        },
        "allowed_commands": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Commands",
          "type": "array"
        },
        "max_attempts": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Attempts"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "TaskConstraints",
      "type": "object"
    },
    "TaskLease": {
      "additionalProperties": false,
      "description": "Expiring claim on Agent capacity for one RoleAssignment.",
      "properties": {
        "kind": {
          "const": "task_lease",
          "default": "task_lease",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^lease_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "assignment_id": {
          "pattern": "^assignment_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Assignment Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "agent_id": {
          "pattern": "^agent_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Agent Id",
          "type": "string"
        },
        "capacity_units": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Capacity Units",
          "type": "integer"
        },
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "assignment_id",
        "task_id",
        "agent_id",
        "acquired_at",
        "expires_at"
      ],
      "title": "TaskLease",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "NEW",
        "PLANNING",
        "IMPLEMENTING",
        "CONTINUE_REQUIRED",
        "QUEUED",
        "QA",
        "REVIEW",
        "DONE",
        "BLOCKED",
        "FAILED"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/RecoveryDispatchRecord"
    },
    {
      "$ref": "#/$defs/ContinuationDispatchRecord"
    },
    {
      "$ref": "#/$defs/RecoverySeedRecord"
    },
    {
      "$ref": "#/$defs/RecoveryInvocationRecord"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/recovery-execution.schema.json"
}
