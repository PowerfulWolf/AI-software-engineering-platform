{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "description": "One independently verifiable condition for Task delivery.",
      "properties": {
        "id": {
          "pattern": "^ac_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "verification": {
          "minLength": 1,
          "title": "Verification",
          "type": "string"
        },
        "test_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Test Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "required",
        "verification"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "AgentRole": {
      "description": "Delivery-runtime roles bound to Task artifacts and state transitions.",
      "enum": [
        "orchestrator",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "BrainTier": {
      "enum": [
        "economy",
        "standard",
        "reasoning",
        "critical"
      ],
      "title": "BrainTier",
      "type": "string"
    },
    "CapturedChanges": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "attempt": {
          "maximum": 10,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "source_revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Source Revision",
          "type": "string"
        },
        "worktree_path": {
          "pattern": "^/[^\\x00-\\x1f]*$",
          "title": "Worktree Path",
          "type": "string"
        },
        "patch": {
          "maxLength": 1000000,
          "title": "Patch",
          "type": "string"
        },
        "index_diff_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Index Diff Sha256",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/CapturedFile"
          },
          "maxItems": 256,
          "title": "Files",
          "type": "array"
        },
        "capture_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Capture Sha256",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "attempt",
        "source_revision",
        "worktree_path",
        "patch",
        "index_diff_sha256",
        "files",
        "capture_sha256"
      ],
      "title": "CapturedChanges",
      "type": "object"
    },
    "CapturedFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "CapturedFile",
      "type": "object"
    },
    "ContinuationDispatchRecord": {
      "additionalProperties": false,
      "description": "Fresh serial Task derived from a durable delivery result such as QA remediation.",
      "properties": {
        "kind": {
          "const": "continuation_dispatch",
          "default": "continuation_dispatch",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v0.1",
          "default": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "pattern": "^dispatch_commit_[a-f0-9]{64}$",
          "title": "Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Repository Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "project_request_id": {
          "pattern": "^request_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Request Id",
          "type": "string"
        },
        "execution_plan_id": {
          "pattern": "^execution_plan_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Execution Plan Id",
          "type": "string"
        },
        "execution_plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Execution Plan Sha256",
          "type": "string"
        },
        "execution_plan_phase_ids": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "pattern": "^phase_[a-z0-9][a-z0-9_-]{1,63}$",
              "type": "string"
            },
            {
              "pattern": "^phase_[a-z0-9][a-z0-9_-]{1,63}$",
              "type": "string"
            },
            {
              "pattern": "^phase_[a-z0-9][a-z0-9_-]{1,63}$",
              "type": "string"
            }
          ],
          "title": "Execution Plan Phase Ids",
          "type": "array"
        },
        "continuation_kind": {
          "const": "verification_remediation",
          "title": "Continuation Kind",
          "type": "string"
        },
        "continuation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Continuation Sha256",
          "type": "string"
        },
        "continuation_plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Continuation Plan Sha256",
          "type": "string"
        },
        "continuation_context_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Continuation Context Sha256",
          "type": "string"
        },
        "target_preparation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Target Preparation Sha256",
          "type": "string"
        },
        "source_delivery_id": {
          "minLength": 1,
          "title": "Source Delivery Id",
          "type": "string"
        },
        "source_task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Source Task Id",
          "type": "string"
        },
        "source_base_revision": {
          "pattern": "^[a-f0-9]{40,64}$",
          "title": "Source Base Revision",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[a-f0-9]{40,64}$",
          "title": "Source Revision",
          "type": "string"
        },
        "source_dispatch_id": {
          "pattern": "^dispatch_commit_[a-f0-9]{64}$",
          "title": "Source Dispatch Id",
          "type": "string"
        },
        "workforce_snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Workforce Snapshot Sha256",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/Task"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/DispatchPhaseCommit"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Phases",
          "type": "array"
        },
        "committed_at": {
          "format": "date-time",
          "title": "Committed At",
          "type": "string"
        },
        "dispatch_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dispatch Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "repository_id",
        "task_id",
        "project_request_id",
        "execution_plan_id",
        "execution_plan_sha256",
        "execution_plan_phase_ids",
        "continuation_kind",
        "continuation_sha256",
        "continuation_plan_sha256",
        "continuation_context_sha256",
        "target_preparation_sha256",
        "source_delivery_id",
        "source_task_id",
        "source_base_revision",
        "source_revision",
        "source_dispatch_id",
        "workforce_snapshot_sha256",
        "task",
        "phases",
        "committed_at",
        "dispatch_sha256"
      ],
      "title": "ContinuationDispatchRecord",
      "type": "object"
    },
    "DispatchPhaseCommit": {
      "additionalProperties": false,
      "description": "Concrete commit-time allocation for one serial delivery role.",
      "properties": {
        "kind": {
          "const": "dispatch_phase_commit",
          "default": "dispatch_phase_commit",
          "title": "Kind",
          "type": "string"
        },
        "phase_id": {
          "pattern": "^phase_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Phase Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "agent_id": {
          "pattern": "^agent_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Agent Id",
          "type": "string"
        },
        "assignment": {
          "$ref": "#/$defs/RoleAssignment"
        },
        "lease": {
          "$ref": "#/$defs/TaskLease"
        },
        "model_selection": {
          "$ref": "#/$defs/ModelSelection"
        }
      },
      "required": [
        "phase_id",
        "role",
        "agent_id",
        "assignment",
        "lease",
        "model_selection"
      ],
      "title": "DispatchPhaseCommit",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ModelRouteReason": {
      "enum": [
        "default",
        "task_complexity",
        "risk_floor",
        "role_floor",
        "context_capacity",
        "objective_escalation",
        "budget_constraint",
        "operator_override"
      ],
      "title": "ModelRouteReason",
      "type": "string"
    },
    "ModelSelection": {
      "additionalProperties": false,
      "description": "Concrete, run-scoped model allocation with machine-readable reasons.",
      "properties": {
        "kind": {
          "const": "model_selection",
          "default": "model_selection",
          "title": "Kind",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^model_policy_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/BrainTier"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/ModelRouteReason"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "selected_at": {
          "format": "date-time",
          "title": "Selected At",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "provider",
        "model",
        "tier",
        "reasons",
        "selected_at"
      ],
      "title": "ModelSelection",
      "type": "object"
    },
