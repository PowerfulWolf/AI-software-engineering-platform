        "attempts": {
          "default": 0,
          "maximum": 10,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "owner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "labels": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "repository",
        "base_ref",
        "acceptance_criteria",
        "status",
        "max_attempts",
        "created_at",
        "updated_at"
      ],
      "title": "Task",
      "type": "object"
    },
    "TaskConstraints": {
      "additionalProperties": false,
