{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/designer-context.schema.json",
  "title": "DesignContextManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "context_id", "project_id", "request_id", "preparation", "project_profile", "project_baseline", "project_request", "product_spec", "product_approval", "solution_design_authorization", "sources", "permissions", "built_at", "context_sha256"],
  "properties": {
    "kind": {"const": "design_context_manifest"},
    "schema_version": {"const": "v0.1"},
    "context_id": {"type": "string", "pattern": "^ctx_[a-f0-9]{64}$"},
    "project_id": {"$ref": "https://ai-software-engineer.local/schemas/project-stage-defs.schema.json#/$defs/projectId"},
    "request_id": {"$ref": "https://ai-software-engineer.local/schemas/project-stage-defs.schema.json#/$defs/requestId"},
    "preparation": {"$ref": "https://ai-software-engineer.local/schemas/project-stage-defs.schema.json#/$defs/ProjectPreparation"},
    "project_profile": {"$ref": "https://ai-software-engineer.local/schemas/project-profile.schema.json"},
    "project_baseline": {"$ref": "https://ai-software-engineer.local/schemas/project-baseline.schema.json#/$defs/ProjectSpecBaseline"},
    "project_request": {"$ref": "https://ai-software-engineer.local/schemas/project-stage-defs.schema.json#/$defs/ProjectRequest"},
    "product_spec": {"$ref": "https://ai-software-engineer.local/schemas/project-stage-defs.schema.json#/$defs/ProductSpec"},
    "product_approval": {"$ref": "https://ai-software-engineer.local/schemas/project-stage-defs.schema.json#/$defs/ProductSpecApproval"},
    "solution_design_authorization": {"$ref": "https://ai-software-engineer.local/schemas/agent-skill-project-manager.schema.json#/$defs/StageAdvanceAuthorization"},
    "sources": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/source"}},
    "permissions": {"$ref": "#/$defs/permissions"},
    "built_at": {"type": "string", "format": "date-time"},
    "context_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["read_project_facts", "read_project_rules", "read_project_request", "read_product_spec", "read_product_approval", "output_technical_design", "write_code", "execute_shell", "modify_product_spec", "modify_product_approval", "advance_project_stage", "create_delivery_task"],
      "properties": {
        "read_project_facts": {"const": true}, "read_project_rules": {"const": true},
        "read_project_request": {"const": true}, "read_product_spec": {"const": true},
        "read_product_approval": {"const": true}, "output_technical_design": {"const": true},
        "write_code": {"const": false}, "execute_shell": {"const": false},
        "modify_product_spec": {"const": false}, "modify_product_approval": {"const": false},
        "advance_project_stage": {"const": false}, "create_delivery_task": {"const": false}
      }
    }
  }
}
