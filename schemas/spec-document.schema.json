{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/spec-document.schema.json",
  "title": "SpecDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "spec_id", "scope", "team_id", "spec_key", "version", "title",
    "body_markdown", "roles", "stages", "repository_ids", "path_globs", "verification",
    "created_at", "spec_sha256"
  ],
  "properties": {
    "schema_version": {"const": "v0.1", "default": "v0.1"},
    "spec_id": {"type": "string", "pattern": "^spec_document_[a-f0-9]{32}$"},
    "scope": {"enum": ["team", "project"]},
    "team_id": {"type": "string", "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$"},
    "project_id": {"type": "string", "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$"},
    "spec_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "body_markdown": {"type": "string", "minLength": 1, "maxLength": 256000},
    "roles": {
      "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
      "items": {"enum": ["manager", "product", "designer", "planner", "coder", "qa", "reviewer"]}
    },
    "stages": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}
    },
    "repository_ids": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$"}
    },
    "path_globs": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "verification": {"type": "string", "minLength": 1, "maxLength": 8000},
    "created_at": {"type": "string", "format": "date-time"},
    "spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "project"}}, "required": ["scope"]},
      "then": {"required": ["project_id"]},
      "else": {"not": {"required": ["project_id"]}}
    }
  ]
}
