{
  "$defs": {
    "EngineeringAdmission": {
      "additionalProperties": false,
      "description": "One exact application of policy, distinct from RecoveryAuthorization.",
      "properties": {
        "kind": {
          "const": "engineering_admission",
          "default": "engineering_admission",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "authorization_source": {
          "const": "organization_engineering_policy",
          "default": "organization_engineering_policy",
          "title": "Authorization Source",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "task_intent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Task Intent Sha256",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/EngineeringPolicy"
        },
        "policy_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "facts_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Facts Sha256",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/EngineeringCapability"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "admission_number": {
          "maximum": 100,
          "minimum": 1,
          "title": "Admission Number",
          "type": "integer"
        },
        "admitted_at": {
          "format": "date-time",
          "title": "Admitted At",
          "type": "string"
        },
        "admission_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Admission Sha256",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "task_intent_sha256",
        "policy",
        "policy_sha256",
        "plan_sha256",
        "facts_sha256",
        "capabilities",
        "admission_number",
        "admitted_at",
        "admission_sha256"
      ],
      "title": "EngineeringAdmission",
      "type": "object"
    },
    "EngineeringCapability": {
      "enum": [
        "delivery_wait_resolution",
        "verification_refresh",
        "swift_sandbox",
        "python_mysql_sandbox",
        "native_ui_sandbox",
        "in_scope_prerequisite_repair",
        "pre_execution_rebind",
        "execution_baseline_rebind",
        "owned_mysql_cleanup"
      ],
      "title": "EngineeringCapability",
      "type": "string"
    },
    "EngineeringGrant": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "#/$defs/EngineeringCapability"
        },
        "max_admissions": {
          "maximum": 20,
          "minimum": 1,
          "title": "Max Admissions",
          "type": "integer"
        }
      },
      "required": [
        "capability",
        "max_admissions"
      ],
      "title": "EngineeringGrant",
      "type": "object"
    },
    "EngineeringPolicy": {
      "additionalProperties": false,
      "description": "Versioned organization decision frozen only on newly admitted Tasks.",
      "properties": {
        "kind": {
          "const": "engineering_policy",
          "default": "engineering_policy",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "policy_id": {
          "default": "local-bounded-engineering-v1",
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "default": 1,
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "authorization_source": {
          "const": "organization_engineering_policy",
          "default": "organization_engineering_policy",
          "title": "Authorization Source",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EngineeringScope"
        },
        "issued_by": {
          "$ref": "#/$defs/LocalOperatorPrincipal"
        },
        "grants": {
          "items": {
            "$ref": "#/$defs/EngineeringGrant"
          },
          "minItems": 1,
          "title": "Grants",
          "type": "array"
        },
        "max_total_admissions": {
          "default": 12,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Total Admissions",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "issued_by",
        "grants"
      ],
      "title": "EngineeringPolicy",
      "type": "object"
    },
    "EngineeringScope": {
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "repository_id": {
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        },
        "repository_root": {
          "minLength": 1,
          "title": "Repository Root",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "project_id",
        "repository_id",
        "repository_root"
      ],
      "title": "EngineeringScope",
      "type": "object"
    },
    "LocalOperatorPrincipal": {
      "additionalProperties": false,
      "description": "Trusted local composition identity; request/model text cannot add duties.",
      "properties": {
        "kind": {
          "const": "trusted_local_operator",
          "default": "trusted_local_operator",
          "title": "Kind",
          "type": "string"
        },
        "operator_id": {
          "minLength": 1,
          "title": "Operator Id",
          "type": "string"
        },
        "duties": {
          "items": {
            "$ref": "#/$defs/OperatorDuty"
          },
          "minItems": 1,
          "title": "Duties",
          "type": "array"
        }
      },
      "required": [
        "operator_id",
        "duties"
      ],
      "title": "LocalOperatorPrincipal",
      "type": "object"
    },
    "OperatorDuty": {
      "enum": [
        "PRODUCT",
        "ENGINEERING"
      ],
      "title": "OperatorDuty",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "engineering_admission": "#/$defs/EngineeringAdmission",
      "engineering_policy": "#/$defs/EngineeringPolicy"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/EngineeringPolicy"
    },
    {
      "$ref": "#/$defs/EngineeringAdmission"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/engineering-authority.schema.json"
}
