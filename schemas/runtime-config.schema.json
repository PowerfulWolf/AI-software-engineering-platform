{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/runtime-config.schema.json",
  "title": "RuntimeConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoint", "model"],
  "$defs": {
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {"type": "string", "minLength": 1},
        "artifacts": {"type": "string", "minLength": 1},
        "contexts": {"type": "string", "minLength": 1},
        "evaluation_events": {"type": "string", "minLength": 1},
        "handoffs": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "runs": {"type": "string", "minLength": 1}
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {"enum": ["sqlite", "mysql"], "default": "sqlite"},
        "mysql_dsn_env": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$", "default": "ASE_MYSQL_DSN"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "uri"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "uri": {"type": "string", "minLength": 1},
        "content": {"type": "string"},
        "relative_path": {"type": "string", "minLength": 1},
        "roles": {"type": "array", "items": {"enum": ["orchestrator", "coder", "qa", "reviewer"]}},
        "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
        "required": {"type": "boolean"}
      },
      "oneOf": [
        {"required": ["content"], "not": {"required": ["relative_path"]}},
        {"required": ["relative_path"], "not": {"required": ["content"]}}
      ]
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": {"enum": ["orchestrator", "coder", "qa", "reviewer"]},
        "agent_id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "read_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "write_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "network": {"enum": ["none", "model_endpoint_only", "allowlist"]},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "token_budget": {"type": "integer", "minimum": 1}
      }
    }
  },
  "properties": {
    "endpoint": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "api_key_env": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$", "default": "OPENAI_API_KEY"},
    "api_key_required": {"type": "boolean", "default": true},
    "agent_version": {"type": "string", "minLength": 1, "default": "v0.1"},
    "prompt_version": {"type": "string", "minLength": 1, "default": "prompt-v0.1"},
    "spec_version": {"type": "string", "minLength": 1, "default": "spec-v0.1"},
    "test_entrypoints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "paths": {"$ref": "#/$defs/paths"},
    "persistence": {"$ref": "#/$defs/persistence"},
    "context_sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "role_overrides": {"type": "array", "items": {"$ref": "#/$defs/override"}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600, "default": 600},
    "token_budget": {"type": "integer", "minimum": 1, "default": 20000},
    "max_retries": {"type": "integer", "minimum": 0, "maximum": 5, "default": 0}
  }
}
