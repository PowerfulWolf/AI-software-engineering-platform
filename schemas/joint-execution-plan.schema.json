{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/joint-execution-plan.schema.json",
  "$defs": {
    "BrainTier": {
      "enum": [
        "economy",
        "standard",
        "reasoning",
        "critical"
      ],
      "title": "BrainTier",
      "type": "string"
    },
    "ExecutionPlanDraft": {
      "additionalProperties": false,
      "properties": {
        "phases": {
          "items": {
            "$ref": "#/$defs/PhaseDraft"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Phases",
          "type": "array"
        },
        "work_graph": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanWorkGraph"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision_feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanRevisionFeedback"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "phases"
      ],
      "title": "ExecutionPlanDraft",
      "type": "object"
    },
    "IntegrationCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "unit_id": {
          "pattern": "^unit_[a-f0-9]{16}$",
          "title": "Unit Id",
          "type": "string"
        },
        "consumes": {
          "items": {
            "pattern": "^unit_[a-f0-9]{16}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Consumes",
          "type": "array"
        },
        "acceptance_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Ids",
          "type": "array"
        },
        "interface_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Interface Ids",
          "type": "array"
        },
        "argv": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "timeout_seconds": {
          "default": 120,
          "maximum": 600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "unit_id",
        "consumes",
        "acceptance_ids",
        "argv"
      ],
      "title": "IntegrationCheck",
      "type": "object"
    },
    "PhaseDraft": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "coder",
            "qa",
            "reviewer"
          ],
          "title": "Role",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "enum": [
              "implementation",
              "testing",
              "review",
              "security",
              "contract-validation",
              "python",
              "java",
              "cpp",
              "go",
              "typescript"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Capabilities",
          "type": "array"
        },
        "risk": {
          "$ref": "#/$defs/RiskTier"
        },
        "minimum_brain_tier": {
          "$ref": "#/$defs/BrainTier"
        },
        "checkpoints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Checkpoints",
          "type": "array"
        }
      },
      "required": [
        "role",
        "objective",
        "required_capabilities",
        "risk",
        "minimum_brain_tier",
        "checkpoints"
      ],
      "title": "PhaseDraft",
      "type": "object"
    },
    "PlanRevisionFeedback": {
      "additionalProperties": false,
      "properties": {
        "previous_plan_id": {
          "pattern": "^execution_plan_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Previous Plan Id",
          "type": "string"
        },
        "previous_plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Previous Plan Sha256",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "required_changes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Changes",
          "type": "array"
        }
      },
      "required": [
        "previous_plan_id",
        "previous_plan_sha256",
        "reason_codes",
        "required_changes"
      ],
      "title": "PlanRevisionFeedback",
      "type": "object"
    },
    "PlanTestItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "acceptance_criterion_ids": {
          "items": {
            "pattern": "^ac_[a-z0-9][a-z0-9_-]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criterion Ids",
          "type": "array"
        },
        "level": {
          "minLength": 1,
          "title": "Level",
          "type": "string"
        },
        "verification": {
          "minLength": 1,
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "id",
        "acceptance_criterion_ids",
        "level",
        "verification"
      ],
      "title": "PlanTestItem",
      "type": "object"
    },
    "PlanWorkGraph": {
      "additionalProperties": false,
      "properties": {
        "packages": {
          "items": {
            "$ref": "#/$defs/PlanWorkPackage"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Packages",
          "type": "array"
        },
        "max_parallelism": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Max Parallelism",
          "type": "integer"
        }
      },
      "required": [
        "packages"
      ],
      "title": "PlanWorkGraph",
      "type": "object"
    },
    "PlanWorkPackage": {
      "additionalProperties": false,
      "description": "Bounded abstract Task proposal; roles within each Task stay serial.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "component_ids": {
          "items": {
            "pattern": "^component_[a-z0-9][a-z0-9_-]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Component Ids",
          "type": "array"
        },
        "step_ids": {
          "items": {
            "pattern": "^design_step_[a-z0-9][a-z0-9_-]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        },
        "acceptance_criterion_ids": {
          "items": {
            "pattern": "^ac_[a-z0-9][a-z0-9_-]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criterion Ids",
          "type": "array"
        },
        "depends_on": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "risk": {
          "$ref": "#/$defs/RiskTier"
        },
        "checkpoints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Checkpoints",
          "type": "array"
        },
        "tests": {
          "items": {
            "$ref": "#/$defs/PlanTestItem"
          },
          "minItems": 1,
          "title": "Tests",
          "type": "array"
        }
      },
      "required": [
        "id",
        "component_ids",
        "step_ids",
        "acceptance_criterion_ids",
        "risk",
        "checkpoints",
        "tests"
      ],
      "title": "PlanWorkPackage",
      "type": "object"
    },
    "RiskTier": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "title": "RiskTier",
      "type": "string"
    },
    "UnitPlan": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^unit_[a-f0-9]{16}$",
          "title": "Unit Id",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "pattern": "^unit_[a-f0-9]{16}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "plan": {
          "$ref": "#/$defs/ExecutionPlanDraft"
        }
      },
      "required": [
        "unit_id",
        "plan"
      ],
      "title": "UnitPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "design_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Design Sha256",
      "type": "string"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/UnitPlan"
      },
      "minItems": 1,
      "title": "Units",
      "type": "array"
    },
    "integration_checks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/IntegrationCheck"
      },
      "title": "Integration Checks",
      "type": "array"
    },
    "max_parallelism": {
      "anyOf": [
        {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Parallelism"
    },
    "version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    },
    "previous_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Plan Sha256"
    },
    "feedback_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feedback Sha256"
    }
  },
  "required": [
    "design_sha256",
    "units"
  ],
  "title": "JointExecutionPlan",
  "type": "object"
}
