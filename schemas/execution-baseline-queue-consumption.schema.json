            },
            {
              "const": "provider_transient",
              "type": "string"
            }
          ],
          "title": "Allowed Causes",
          "type": "array"
        },
        "allowed_changes": {
          "default": [
            "text_added",
            "text_modified"
          ],
          "items": {
            "enum": [
              "text_added",
              "text_modified",
              "text_deleted",
              "regular_mode_changed"
            ],
            "type": "string"
          },
          "title": "Allowed Changes",
          "type": "array"
        }
      },
      "title": "InterruptionContinuationPolicy",
      "type": "object"
    },
