    "InterruptionContinuationPolicy": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "capability_id": {
                "const": "git-regular-text-mutation-inventory-v2"
              },
              "allowed_changes": {
                "const": [
                  "text_added",
                  "text_modified",
                  "text_deleted",
                  "regular_mode_changed"
                ]
              }
            },
            "required": [
              "capability_id",
              "allowed_changes"
            ]
          },
          "if": {
            "properties": {
              "schema_version": {
                "const": "v1"
              }
            }
          },
          "then": {
            "properties": {
              "capability_id": {
                "const": "git-text-mutation-inventory-v1"
              },
              "max_continuations": {
                "const": 1
              },
              "allowed_changes": {
                "const": [
                  "text_added",
                  "text_modified"
                ]
              }
            }
          }
        }
      ],
      "description": "Frozen narrow capability; legacy Tasks have no implicit authorization.",
      "properties": {
        "kind": {
          "const": "interruption_continuation_policy",
          "default": "interruption_continuation_policy",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": "v1",
          "enum": [
            "v1",
            "v2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "authorization_source": {
          "const": "organization_engineering_policy",
          "default": "organization_engineering_policy",
          "title": "Authorization Source",
          "type": "string"
        },
        "capability_id": {
          "default": "git-text-mutation-inventory-v1",
          "enum": [
            "git-text-mutation-inventory-v1",
            "git-regular-text-mutation-inventory-v2"
          ],
          "title": "Capability Id",
          "type": "string"
        },
        "max_continuations": {
          "default": 1,
          "maximum": 199,
          "minimum": 1,
          "title": "Max Continuations",
          "type": "integer"
        },
        "allowed_causes": {
          "default": [
            "local_execution_limit",
            "provider_transient"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "local_execution_limit",
