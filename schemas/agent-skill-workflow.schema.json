{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/agent-skill-workflow.schema.json",
  "$defs": {
    "KnowledgeRunBinding": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "role": {
          "$ref": "#/$defs/TeamRole"
        },
        "team_id": {
          "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Team Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "repository_ids": {
          "items": {
            "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Repository Ids",
          "type": "array"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Context Manifest Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "role",
        "team_id",
        "project_id",
        "requirement_id",
        "repository_ids",
        "source_revision",
        "context_manifest_id",
        "snapshot_sha256"
      ],
      "title": "KnowledgeRunBinding",
      "type": "object"
    },
    "TeamRole": {
      "description": "Long-lived roles that a Team-owned AgentProfile may declare.",
      "enum": [
        "manager",
        "product",
        "designer",
        "planner",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "TeamRole",
      "type": "string"
    },
    "WorkflowGateFacts": {
      "additionalProperties": false,
      "description": "Application-verified facts, never a model's declaration of success.",
      "properties": {
        "binding": {
          "$ref": "#/$defs/KnowledgeRunBinding"
        },
        "knowledge_manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Knowledge Manifest Sha256",
          "type": "string"
        },
        "durable_evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Durable Evidence",
          "type": "array"
        },
        "required_acceptance_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Acceptance Ids",
          "type": "array"
        },
        "covered_acceptance_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Covered Acceptance Ids",
          "type": "array"
        },
        "independent_agent_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Independent Agent Ids",
          "type": "array"
        },
        "unresolved_blocking_gap_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Unresolved Blocking Gap Ids",
          "type": "array"
        },
        "final_context_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Context Id"
        },
        "candidate_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Revision"
        }
      },
      "required": [
        "binding",
        "knowledge_manifest_sha256",
        "durable_evidence"
      ],
      "title": "WorkflowGateFacts",
      "type": "object"
    },
    "WorkflowSkillDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "start",
            "planning-gate",
            "recovery",
            "finish-work",
            "knowledge-facts",
            "before-dev",
            "architecture-check",
            "plan",
            "implementation-check",
            "learning-proposal",
            "acceptance-matrix",
            "test-gaps",
            "code-review",
            "spec-review",
            "break-loop"
          ],
          "title": "Name",
          "type": "string"
        },
        "version": {
          "const": "v1",
          "default": "v1",
          "title": "Version",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/TeamRole"
        },
        "input_contract": {
          "const": "WorkflowGateFacts",
          "default": "WorkflowGateFacts",
          "title": "Input Contract",
          "type": "string"
        },
        "output_contract": {
          "const": "WorkflowSkillEvidence",
          "default": "WorkflowSkillEvidence",
          "title": "Output Contract",
          "type": "string"
        },
        "failure_policy": {
          "const": "BLOCK",
          "default": "BLOCK",
          "title": "Failure Policy",
          "type": "string"
        },
        "executable_kind": {
          "const": "deterministic_gate",
          "default": "deterministic_gate",
          "title": "Executable Kind",
          "type": "string"
        },
        "ports": {
          "default": [
            "read_knowledge_evidence",
            "read_durable_delivery_facts"
          ],
          "items": {
            "enum": [
              "read_knowledge_evidence",
              "read_durable_delivery_facts"
            ],
            "type": "string"
          },
          "title": "Ports",
          "type": "array"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "title": "WorkflowSkillDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "definition": {
      "$ref": "#/$defs/WorkflowSkillDefinition"
    },
    "facts": {
      "$ref": "#/$defs/WorkflowGateFacts"
    },
    "status": {
      "enum": [
        "PASSED",
        "REJECTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "evidence_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    }
  },
  "required": [
    "definition",
    "facts",
    "status",
    "reasons",
    "evidence_sha256"
  ],
  "title": "WorkflowSkillEvidence",
  "type": "object"
}
