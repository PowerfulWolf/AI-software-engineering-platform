{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/knowledge-delivery-proof.schema.json",
  "$defs": {
    "KnowledgeRunBinding": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "role": {
          "$ref": "#/$defs/TeamRole"
        },
        "team_id": {
          "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Team Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "repository_ids": {
          "items": {
            "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Repository Ids",
          "type": "array"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Context Manifest Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "role",
        "team_id",
        "project_id",
        "requirement_id",
        "repository_ids",
        "source_revision",
        "context_manifest_id",
        "snapshot_sha256"
      ],
      "title": "KnowledgeRunBinding",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "NEW",
        "PLANNING",
        "IMPLEMENTING",
        "CONTINUE_REQUIRED",
        "QUEUED",
        "QA",
        "REVIEW",
        "DONE",
        "BLOCKED",
        "FAILED"
      ],
      "title": "TaskStatus",
      "type": "string"
    },
    "TeamRole": {
      "description": "Long-lived roles that a Team-owned AgentProfile may declare.",
      "enum": [
        "manager",
        "product",
        "designer",
        "planner",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "TeamRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "target_status": {
      "$ref": "#/$defs/TaskStatus"
    },
    "artifact_digests": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Artifact Digests",
      "type": "array"
    },
    "required_acceptance_ids": {
      "items": {
        "type": "string"
      },
      "title": "Required Acceptance Ids",
      "type": "array"
    },
    "covered_acceptance_ids": {
      "items": {
        "type": "string"
      },
      "title": "Covered Acceptance Ids",
      "type": "array"
    },
    "independent_agent_ids": {
      "items": {
        "type": "string"
      },
      "title": "Independent Agent Ids",
      "type": "array"
    },
    "consultation_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeRunBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "final_context_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Context Id"
    },
    "candidate_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Revision"
    },
    "proof_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Proof Sha256",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "target_status",
    "artifact_digests",
    "required_acceptance_ids",
    "covered_acceptance_ids",
    "independent_agent_ids",
    "proof_sha256"
  ],
  "title": "DeliveryWorkflowProof",
  "type": "object"
}
