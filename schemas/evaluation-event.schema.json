{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/evaluation-event.schema.json",
  "title": "Evaluation event",
  "oneOf": [
    {"$ref": "#/$defs/caseStarted"},
    {"$ref": "#/$defs/agentRun"},
    {"$ref": "#/$defs/humanAction"},
    {"$ref": "#/$defs/regressionCheck"}
  ],
  "$defs": {
    "eventId": {
      "type": "string",
      "pattern": "^evalevt_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^case_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "caseStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "case_id",
        "task_id",
        "kind",
        "occurred_at",
        "base_revision",
        "model_id",
        "prompt_version",
        "spec_version",
        "test_entrypoints",
        "included"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/eventId"},
        "case_id": {"$ref": "#/$defs/caseId"},
        "task_id": {"$ref": "#/$defs/taskId"},
        "kind": {"const": "case_started"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "base_revision": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "spec_version": {"type": "string", "minLength": 1},
        "test_entrypoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "included": {"type": "boolean"}
      }
    },
    "agentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "case_id",
        "task_id",
        "kind",
        "occurred_at",
        "run_id",
        "role",
        "attempt",
        "output_status",
        "policy_violations",
        "caught_policy_violations"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/eventId"},
        "case_id": {"$ref": "#/$defs/caseId"},
        "task_id": {"$ref": "#/$defs/taskId"},
        "kind": {"const": "agent_run"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "run_id": {"type": "string", "pattern": "^run_[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"},
        "role": {"enum": ["orchestrator", "coder", "qa", "reviewer"]},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 10},
        "output_status": {"enum": ["VALID", "INVALID", "NOT_PRODUCED"]},
        "artifact_id": {"$ref": "#/$defs/artifactId"},
        "policy_violations": {"type": "integer", "minimum": 0},
        "caught_policy_violations": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"output_status": {"const": "VALID"}}},
          "then": {"required": ["artifact_id"]},
          "else": {"not": {"required": ["artifact_id"]}}
        }
      ]
    },
    "humanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "case_id",
        "task_id",
        "kind",
        "occurred_at",
        "action",
        "evidence_uri"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/eventId"},
        "case_id": {"$ref": "#/$defs/caseId"},
        "task_id": {"$ref": "#/$defs/taskId"},
        "kind": {"const": "human_action"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "action": {
          "enum": [
            "START_TASK",
            "VIEW_HANDOFF",
            "MERGE_DELIVERY",
            "CLARIFY_REQUIREMENTS",
            "MODIFY_CODE",
            "MODIFY_TESTS",
            "REWRITE_VERDICT",
            "SUPPLY_EVIDENCE",
            "OVERRIDE_POLICY"
          ]
        },
        "evidence_uri": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "regressionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "case_id",
        "task_id",
        "kind",
        "occurred_at",
        "status",
        "window_started_at",
        "window_ended_at",
        "evidence_uri",
        "hidden_tests"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/eventId"},
        "case_id": {"$ref": "#/$defs/caseId"},
        "task_id": {"$ref": "#/$defs/taskId"},
        "kind": {"const": "regression_check"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["PASS", "FAIL"]},
        "window_started_at": {"type": "string", "format": "date-time"},
        "window_ended_at": {"type": "string", "format": "date-time"},
        "evidence_uri": {"type": "string", "minLength": 1},
        "hidden_tests": {"type": "boolean"}
      }
    }
  }
}
