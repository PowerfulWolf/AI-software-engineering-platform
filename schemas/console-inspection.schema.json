{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "kind": {
      "const": "persistent_console_inspection",
      "default": "persistent_console_inspection",
      "title": "Kind",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    },
    "successor_mode": {
      "const": "inspection",
      "default": "inspection",
      "title": "Successor Mode",
      "type": "string"
    },
    "historical_execution_outcome": {
      "const": "UNKNOWN",
      "default": "UNKNOWN",
      "title": "Historical Execution Outcome",
      "type": "string"
    }
  },
  "required": [
    "recorded_at",
    "record_sha256",
    "plan_sha256",
    "receipt_sha256"
  ],
  "title": "InspectionMarker",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
