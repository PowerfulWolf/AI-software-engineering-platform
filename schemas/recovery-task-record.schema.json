{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/recovery-task-record.schema.json",
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "description": "One independently verifiable condition for Task delivery.",
      "properties": {
        "id": {
          "pattern": "^ac_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "verification": {
          "minLength": 1,
          "title": "Verification",
          "type": "string"
        },
        "test_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Test Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "required",
        "verification"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ProjectRequest": {
      "additionalProperties": false,
      "description": "Durable product request before it becomes a Delivery Task.",
      "properties": {
        "kind": {
          "const": "project_request",
          "default": "project_request",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v0.1",
          "default": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "pattern": "^request_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Repository Id",
          "type": "string"
        },
        "preparation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Preparation Sha256",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "original_request": {
          "minLength": 1,
          "title": "Original Request",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProjectRequestStatus"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "repository_id",
        "preparation_sha256",
        "title",
        "original_request",
        "status",
        "created_at",
        "updated_at",
        "request_sha256"
      ],
      "title": "ProjectRequest",
      "type": "object"
    },
    "ProjectRequestStatus": {
      "enum": [
        "PRODUCT_DISCOVERY",
        "WAITING_PRODUCT_APPROVAL",
        "DESIGNING",
        "PLANNING",
        "READY_FOR_DELIVERY",
        "DELIVERING",
        "REPORTING",
        "DONE",
        "WAITING_HUMAN",
        "BLOCKED"
      ],
      "title": "ProjectRequestStatus",
      "type": "string"
    },
    "Task": {
      "additionalProperties": false,
      "description": "A bounded request tied to one repository and delivery state.",
      "properties": {
        "id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "base_ref": {
          "minLength": 1,
          "title": "Base Ref",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "constraints": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskConstraints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "max_attempts": {
          "maximum": 400,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "attempts": {
          "default": 0,
          "maximum": 400,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "owner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "labels": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "retry_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryRetryPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retry_failures": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DeliveryRetryFailure"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Failures"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "repository",
        "base_ref",
        "acceptance_criteria",
        "status",
        "max_attempts",
        "created_at",
        "updated_at"
      ],
      "title": "Task",
      "type": "object"
    },
    "TaskConstraints": {
      "additionalProperties": false,
      "description": "Machine-consumable restrictions attached to a Task.",
      "properties": {
        "allowed_paths": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Paths",
          "type": "array"
        },
        "denied_paths": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Denied Paths",
          "type": "array"
        },
        "allowed_commands": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Commands",
          "type": "array"
        },
        "max_attempts": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Attempts"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "TaskConstraints",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "NEW",
        "PLANNING",
        "IMPLEMENTING",
        "CONTINUE_REQUIRED",
        "QUEUED",
        "QA",
        "REVIEW",
        "DONE",
        "BLOCKED",
        "FAILED"
      ],
      "title": "TaskStatus",
      "type": "string"
    },
    "DeliveryRetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_work_attempts": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Work Attempts",
          "type": "integer"
        },
        "coder": {
          "$ref": "#/$defs/TransientRetryPolicy",
          "default": {
            "max_transient_failures": 5
          }
        },
        "qa": {
          "$ref": "#/$defs/TransientRetryPolicy",
          "default": {
            "max_transient_failures": 5
          }
        },
        "reviewer": {
          "$ref": "#/$defs/TransientRetryPolicy",
          "default": {
            "max_transient_failures": 5
          }
        }
      },
      "title": "DeliveryRetryPolicy",
      "type": "object"
    },
    "DeliveryRetryFailure": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "coder",
            "qa",
            "reviewer"
          ],
          "title": "Role",
          "type": "string"
        },
        "attempt": {
          "maximum": 400,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "code": {
          "enum": [
            "TIMEOUT",
            "QUOTA_EXHAUSTED",
            "RATE_LIMITED",
            "PROVIDER_UNAVAILABLE"
          ],
          "title": "Code",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "role",
        "attempt",
        "code"
      ],
      "title": "DeliveryRetryFailure",
      "type": "object"
    },
    "TransientRetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_transient_failures": {
          "default": 5,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Transient Failures",
          "type": "integer"
        }
      },
      "title": "TransientRetryPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "recovery_task_record",
      "default": "recovery_task_record",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "v0.1",
      "default": "v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "recovery_plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Recovery Plan Sha256",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "rebound_request": {
      "$ref": "#/$defs/ProjectRequest"
    },
    "task": {
      "$ref": "#/$defs/Task",
      "allOf": [
        {
          "properties": {
            "status": {
              "const": "NEW"
            },
            "attempts": {
              "const": 0
            }
          }
        }
      ]
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    }
  },
  "required": [
    "recovery_plan_sha256",
    "authorization_sha256",
    "rebound_request",
    "task",
    "record_sha256"
  ],
  "title": "RecoveryTaskRecord",
  "type": "object"
}
