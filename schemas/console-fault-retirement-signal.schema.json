{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "kind": {
      "const": "exact_host_fault_signal_sent",
      "default": "exact_host_fault_signal_sent",
      "title": "Kind",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    }
  },
  "required": [
    "recorded_at",
    "record_sha256",
    "plan_sha256"
  ],
  "title": "SignalSent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
