{
  "$defs": {
    "AgentPermissions": {
      "additionalProperties": false,
      "description": "The executable path, command, network, and state capabilities of an Agent.",
      "properties": {
        "read_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Read Paths",
          "type": "array"
        },
        "write_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Write Paths",
          "type": "array"
        },
        "commands": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "network": {
          "$ref": "#/$defs/NetworkAccess"
        },
        "can_change_state": {
          "default": false,
          "title": "Can Change State",
          "type": "boolean"
        },
        "can_merge": {
          "default": false,
          "title": "Can Merge",
          "type": "boolean"
        }
      },
      "required": [
        "read_paths",
        "write_paths",
        "commands",
        "network"
      ],
      "title": "AgentPermissions",
      "type": "object"
    },
    "CapturedChanges": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "attempt": {
          "maximum": 400,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "source_revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Source Revision",
          "type": "string"
        },
        "worktree_path": {
          "pattern": "^/[^\\x00-\\x1f]*$",
          "title": "Worktree Path",
          "type": "string"
        },
        "patch": {
          "maxLength": 1000000,
          "title": "Patch",
          "type": "string"
        },
        "index_diff_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Index Diff Sha256",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/CapturedFile"
          },
          "maxItems": 256,
          "title": "Files",
          "type": "array"
        },
        "capture_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Capture Sha256",
          "type": "string"
        },
        "base_revision": {
          "anyOf": [
            {
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Revision"
        },
        "branch_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 11,
              "pattern": "^ai/(feature|bugfix)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch Name"
        }
      },
      "required": [
        "task_id",
        "attempt",
        "source_revision",
        "worktree_path",
        "patch",
        "index_diff_sha256",
        "files",
        "capture_sha256"
      ],
      "title": "CapturedChanges",
      "type": "object"
    },
    "CapturedFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "CapturedFile",
      "type": "object"
    },
    "NetworkAccess": {
      "enum": [
        "none",
        "model_endpoint_only",
        "allowlist"
      ],
      "title": "NetworkAccess",
      "type": "string"
    },
    "RecoveryApprovalCommand": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "pattern": "^[a-z][a-z0-9_-]{2,127}$",
          "title": "Operation Id",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "approval_reference": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Approval Reference",
          "type": "string"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "plan_sha256",
        "approval_reference",
        "submitted_at"
      ],
      "title": "RecoveryApprovalCommand",
      "type": "object"
    },
    "RecoveryAuthorization": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "recovery_authorization",
          "default": "recovery_authorization",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v0.1",
          "default": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "command": {
          "$ref": "#/$defs/RecoveryApprovalCommand"
        },
        "decision": {
          "$ref": "#/$defs/VerifiedRecoveryDecision"
        },
        "authorization_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Authorization Sha256",
          "type": "string"
        }
      },
      "required": [
        "command",
        "decision",
        "authorization_sha256",
        "kind"
      ],
      "title": "RecoveryAuthorization",
      "type": "object"
    },
    "RecoveryPathRebinding": {
      "additionalProperties": false,
      "properties": {
        "source_path": {
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f]+$",
          "title": "Source Path",
          "type": "string"
        },
        "target_path": {
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f]+$",
          "title": "Target Path",
          "type": "string"
        },
        "reason": {
          "const": "missing_source_path_unique_match",
          "default": "missing_source_path_unique_match",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "target_path"
      ],
      "title": "RecoveryPathRebinding",
      "type": "object"
    },
    "RecoveryScopeSupplement": {
      "additionalProperties": false,
      "description": "Deterministic request to approve exact changed paths missing from Coder policy.",
      "properties": {
        "kind": {
          "const": "recovery_scope_supplement",
          "default": "recovery_scope_supplement",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v0.1",
          "default": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/RecoveryScope"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "task_revision": {
          "minimum": 1,
          "title": "Task Revision",
          "type": "integer"
        },
        "checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "base_revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Base Revision",
          "type": "string"
        },
        "permissions_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Permissions Sha256",
          "type": "string"
        },
        "denied_paths_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Denied Paths Sha256",
          "type": "string"
        },
        "paths": {
          "items": {
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f]+$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "supplement_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Supplement Sha256",
          "type": "string"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryScopeRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requested_files": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RecoveryRequestedFile"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Files"
        }
      },
      "required": [
        "scope",
        "task_id",
        "task_revision",
        "checkpoint_sha256",
        "base_revision",
        "permissions_sha256",
        "denied_paths_sha256",
        "paths",
        "supplement_sha256"
      ],
      "title": "RecoveryScopeSupplement",
      "type": "object",
      "allOf": [
        {
          "if": {
            "required": [
              "request"
            ],
            "properties": {
              "request": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "then": {
            "required": [
              "requested_files"
            ],
            "properties": {
              "requested_files": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "requested_files"
            ],
            "properties": {
              "requested_files": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "then": {
            "required": [
              "request"
            ],
            "properties": {
              "request": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "RecoveryPlan": {
      "additionalProperties": false,
      "properties": {
        "input_mode": {
          "anyOf": [
            {
              "const": "coder_reapply",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Mode"
        },
        "kind": {
          "const": "recovery_plan",
          "default": "recovery_plan",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v0.1",
          "default": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/RecoverySource"
        },
        "capture": {
          "$ref": "#/$defs/CapturedChanges"
        },
        "target_base_revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Target Base Revision",
          "type": "string"
        },
        "target_preparation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Target Preparation Sha256",
          "type": "string"
        },
        "scope_supplement": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryScopeSupplement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope_approval_reference": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Approval Reference"
        },
        "permissions": {
          "$ref": "#/$defs/AgentPermissions",
          "allOf": [
            {
              "properties": {
                "can_merge": {
                  "const": false
                },
                "can_change_state": {
                  "const": false
                }
              }
            }
          ]
        },
        "target_permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentPermissions",
              "allOf": [
                {
                  "properties": {
                    "can_merge": {
                      "const": false
                    },
                    "can_change_state": {
                      "const": false
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Permissions"
        },
        "path_rebindings": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RecoveryPathRebinding"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path Rebindings"
        },
        "denied_paths": {
          "items": {
            "type": "string"
          },
          "title": "Denied Paths",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "target_branch_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 11,
              "pattern": "^ai/(feature|bugfix)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Branch Name"
        },
        "retry_of_plan_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Of Plan Sha256"
        },
        "retry_of_task_id": {
          "anyOf": [
            {
              "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Of Task Id"
        },
        "retry_of_checkpoint_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Of Checkpoint Sha256"
        },
        "quarantined_paths": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "pattern": "^[^\\x00-\\x1f]+$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quarantined Paths"
        },
        "workspace_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryWorkspaceSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source",
        "capture",
        "target_base_revision",
        "target_preparation_sha256",
        "permissions",
        "denied_paths",
        "created_at",
        "plan_sha256",
        "kind"
      ],
      "title": "RecoveryPlan",
      "type": "object",
      "allOf": [
        {
          "if": {
            "required": [
              "quarantined_paths"
            ],
            "properties": {
              "quarantined_paths": {
                "type": "array"
              }
            }
          },
          "then": {
            "required": [
              "input_mode"
            ],
            "properties": {
              "input_mode": {
                "const": "coder_reapply"
              }
            }
          }
        }
      ]
    },
    "RecoveryScope": {
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Team Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Repository Id",
          "type": "string"
        },
        "delivery_id": {
          "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "repository_root": {
          "pattern": "^/[^\\x00-\\x1f]*$",
          "title": "Project Root",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "repository_id",
        "delivery_id",
        "repository_root"
      ],
      "title": "RecoveryScope",
      "type": "object"
    },
    "RecoverySource": {
      "additionalProperties": false,
      "description": "Exact references; a trusted facts port must resolve and verify their origin.",
      "properties": {
        "scope": {
          "$ref": "#/$defs/RecoveryScope"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "task_status": {
          "const": "BLOCKED",
          "default": "BLOCKED",
          "title": "Task Status",
          "type": "string"
        },
        "task_revision": {
          "minimum": 1,
          "title": "Task Revision",
          "type": "integer"
        },
        "task_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Task Sha256",
          "type": "string"
        },
        "checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "dispatch_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dispatch Sha256",
          "type": "string"
        },
        "preparation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Preparation Sha256",
          "type": "string"
        },
        "product_spec_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Product Spec Sha256",
          "type": "string"
        },
        "approval_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Approval Sha256",
          "type": "string"
        },
        "technical_design_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Technical Design Sha256",
          "type": "string"
        },
        "execution_plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Execution Plan Sha256",
          "type": "string"
        },
        "failed_run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Failed Run Id",
          "type": "string"
        },
        "failed_context_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Failed Context Id",
          "type": "string"
        },
        "base_revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Base Revision",
          "type": "string"
        },
        "execution_baseline_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Baseline Sha256"
        },
        "execution_base_revision": {
          "anyOf": [
            {
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Base Revision"
        },
        "parent_delivery_id": {
          "anyOf": [
            {
              "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Delivery Id"
        },
        "parent_checkpoint_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Checkpoint Sha256"
        }
      },
      "required": [
        "scope",
        "task_id",
        "task_revision",
        "task_sha256",
        "checkpoint_sha256",
        "dispatch_sha256",
        "preparation_sha256",
        "product_spec_sha256",
        "approval_sha256",
        "technical_design_sha256",
        "execution_plan_sha256",
        "failed_run_id",
        "failed_context_id",
        "base_revision"
      ],
      "title": "RecoverySource",
      "type": "object",
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "execution_baseline_sha256": {
                  "type": "null"
                },
                "execution_base_revision": {
                  "type": "null"
                }
              }
            },
            {
              "required": [
                "execution_baseline_sha256",
                "execution_base_revision"
              ],
              "properties": {
                "execution_baseline_sha256": {
                  "type": "string"
                },
                "execution_base_revision": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    },
    "VerifiedRecoveryDecision": {
      "additionalProperties": false,
      "properties": {
        "plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "approval_reference": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Approval Reference",
          "type": "string"
        },
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "operator_id": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Operator Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "plan_sha256",
        "approval_reference",
        "approved",
        "operator_id",
        "rationale",
        "decided_at"
      ],
      "title": "VerifiedRecoveryDecision",
      "type": "object"
    },
    "RecoveryScopeRequest": {
      "additionalProperties": false,
      "description": "Operator-selected exact missing files, bound to accepted Coder progress.",
      "properties": {
        "progress_artifact_id": {
          "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Progress Artifact Id",
          "type": "string"
        },
        "progress_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Progress Sha256",
          "type": "string"
        },
        "paths": {
          "items": {
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Paths",
          "type": "array",
          "uniqueItems": true
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "progress_artifact_id",
        "progress_sha256",
        "paths",
        "reason"
      ],
      "title": "RecoveryScopeRequest",
      "type": "object"
    },
    "RecoveryRequestedFile": {
      "additionalProperties": false,
      "description": "Read-only Git metadata; no pre-approval read of omitted file contents.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Path",
          "type": "string"
        },
        "mode": {
          "enum": [
            "100644",
            "100755"
          ],
          "title": "Mode",
          "type": "string"
        },
        "blob_id": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Blob Id",
          "type": "string"
        }
      },
      "required": [
        "path",
        "mode",
        "blob_id"
      ],
      "title": "RecoveryRequestedFile",
      "type": "object"
    },
    "MutationFile": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "symlink",
            "git_directory"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "mode": {
          "title": "Mode",
          "type": "integer"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind",
        "sha256",
        "mode",
        "size"
      ],
      "title": "MutationFile",
      "type": "object"
    },
    "RecoveryExcludedPath": {
      "additionalProperties": false,
      "description": "No-follow metadata only; an excluded environment entry is never replayed.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "symlink"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "mode": {
          "maximum": 4095,
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        },
        "size": {
          "maximum": 16000000,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind",
        "sha256",
        "mode",
        "size"
      ],
      "title": "RecoveryExcludedPath",
      "type": "object"
    },
    "RecoveryWorkspaceScope": {
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Team Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Repository Id",
          "type": "string"
        },
        "requirement_id": {
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "dispatch_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dispatch Sha256",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "project_id",
        "repository_id",
        "requirement_id",
        "dispatch_sha256"
      ],
      "title": "RecoveryWorkspaceScope",
      "type": "object"
    },
    "RecoveryWorkspaceSnapshot": {
      "additionalProperties": false,
      "description": "A stopped terminal workspace audit, not progress, a verdict, or retry authority.",
      "properties": {
        "kind": {
          "const": "recovery_workspace_snapshot",
          "default": "recovery_workspace_snapshot",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/RecoveryWorkspaceScope"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "task_revision": {
          "minimum": 1,
          "title": "Task Revision",
          "type": "integer"
        },
        "task_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Task Sha256",
          "type": "string"
        },
        "task_intent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Task Intent Sha256",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Context Manifest Id",
          "type": "string"
        },
        "worktree_path": {
          "pattern": "^/[^\\x00-\\x1f]*$",
          "title": "Worktree Path",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Source Revision",
          "type": "string"
        },
        "effective_capture_base": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Effective Capture Base",
          "type": "string"
        },
        "execution_baseline_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Baseline Sha256"
        },
        "capture_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Capture Sha256",
          "type": "string"
        },
        "capture_start_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Capture Start Sha256",
          "type": "string"
        },
        "capture_stop_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Capture Stop Sha256",
          "type": "string"
        },
        "invocation_start_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Invocation Start Sha256",
          "type": "string"
        },
        "invocation_outcome_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Invocation Outcome Sha256",
          "type": "string"
        },
        "claim_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Claim Sha256",
          "type": "string"
        },
        "step_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Step Sha256",
          "type": "string"
        },
        "routes_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Routes Sha256",
          "type": "string"
        },
        "inventory_before_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Inventory Before Sha256",
          "type": "string"
        },
        "inventory_after": {
          "$ref": "#/$defs/WorkspaceMutationInventory"
        },
        "inventory_after_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Inventory After Sha256",
          "type": "string"
        },
        "excluded_paths": {
          "items": {
            "$ref": "#/$defs/RecoveryExcludedPath"
          },
          "maxItems": 20000,
          "title": "Excluded Paths",
          "type": "array"
        },
        "stopped_at": {
          "format": "date-time",
          "title": "Stopped At",
          "type": "string"
        },
        "blocked_at": {
          "format": "date-time",
          "title": "Blocked At",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "task_id",
        "task_revision",
        "task_sha256",
        "task_intent_sha256",
        "run_id",
        "context_manifest_id",
        "worktree_path",
        "source_revision",
        "effective_capture_base",
        "capture_sha256",
        "capture_start_sha256",
        "capture_stop_sha256",
        "invocation_start_sha256",
        "invocation_outcome_sha256",
        "claim_sha256",
        "step_sha256",
        "routes_sha256",
        "inventory_before_sha256",
        "inventory_after",
        "inventory_after_sha256",
        "excluded_paths",
        "stopped_at",
        "blocked_at",
        "created_at",
        "snapshot_sha256"
      ],
      "title": "RecoveryWorkspaceSnapshot",
      "type": "object"
    },
    "WorkspaceMutationInventory": {
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/MutationFile"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "title": "WorkspaceMutationInventory",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "recovery_authorization": "#/$defs/RecoveryAuthorization",
      "recovery_plan": "#/$defs/RecoveryPlan"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RecoveryPlan"
    },
    {
      "$ref": "#/$defs/RecoveryAuthorization"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/delivery-recovery.schema.json",
  "title": "Explicit recovery plan or verified human decision receipt"
}
