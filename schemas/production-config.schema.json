{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/production-config.schema.json",
  "title": "ProductionConfig",
  "description": "Secret-free operator configuration for the Team-owned Production Team Host.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_routes"],
  "$defs": {
    "env_var": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {"const": "mysql", "default": "mysql"},
        "dsn_env": {"$ref": "#/$defs/env_var", "default": "ASE_MYSQL_DSN"}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "kind"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "kind": {"enum": ["codex_cli", "responses"]},
        "endpoint": {
          "anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}],
          "default": null
        },
        "api_key_env": {
          "anyOf": [{"$ref": "#/$defs/env_var"}, {"type": "null"}],
          "default": null
        },
        "reasoning_effort": {
          "enum": ["low", "medium", "high", "xhigh"],
          "default": "medium"
        },
        "enabled": {"type": "boolean", "default": true}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "codex_cli"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "endpoint": {"type": "null"},
              "api_key_env": {"type": "null"}
            }
          },
          "else": {
            "required": ["endpoint", "api_key_env"],
            "properties": {
              "endpoint": {"type": "string", "minLength": 1},
              "api_key_env": {"$ref": "#/$defs/env_var"}
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "v0.2", "default": "v0.2"},
    "platform_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/(?!.*[\\u0000-\\u001F])(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$)).*|~/(?!.*[\\u0000-\\u001F])(?!/)(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$)).*)$",
      "description": "Optional on macOS and Linux, where it defaults to ~/.ase. Explicit absolute paths and safe leading ~/ paths are supported; resolution does not create directories."
    },
    "team_id": {"type": "string", "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$", "default": "team_ai"},
    "team_name": {"type": "string", "minLength": 1, "maxLength": 200, "default": "AI Team"},
    "team_knowledge_paths": {
      "type": "array", "maxItems": 64, "uniqueItems": true, "default": [],
      "items": {"type": "string", "minLength": 1}
    },
    "default_project_id": {
      "anyOf": [
        {"type": "string", "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$"},
        {"type": "null"}
      ],
      "default": null
    },
    "default_project_name": {
      "anyOf": [
        {"type": "string", "minLength": 1, "maxLength": 200},
        {"type": "null"}
      ],
      "default": null
    },
    "project_knowledge_paths": {
      "type": "array", "maxItems": 64, "uniqueItems": true, "default": [],
      "items": {"type": "string", "minLength": 1}
    },
    "database": {"$ref": "#/$defs/database"},
    "model_routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/route"}
    },
    "codex_executable": {"type": "string", "minLength": 1, "default": "codex"},
    "live_model_execution": {"type": "boolean", "default": false},
    "console_port": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 8765}
  },
  "allOf": [
    {
      "if": {"required": ["default_project_id"]},
      "then": {"required": ["default_project_name"]}
    },
    {
      "if": {"required": ["default_project_name"]},
      "then": {"required": ["default_project_id"]}
    }
  ]
}
