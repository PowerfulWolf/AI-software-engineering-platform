    "VerificationRetryEvidence": {
      "additionalProperties": false,
      "description": "A real inconclusive QA result on a retained candidate, never a code defect.",
      "properties": {
        "candidate_revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Candidate Revision",
          "type": "string"
        },
        "previous_qa_artifact_id": {
          "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Previous Qa Artifact Id",
          "type": "string"
        },
        "previous_qa_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Previous Qa Sha256",
          "type": "string"
        },
        "previous_run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Previous Run Id",
          "type": "string"
        },
        "previous_context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Previous Context Manifest Id",
          "type": "string"
        },
        "invocation_outcome_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Invocation Outcome Sha256",
          "type": "string"
        },
        "prerequisite_facts_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prerequisite Facts Sha256",
          "type": "string"
        },
        "budget_source": {
          "const": "frozen_work_attempt",
          "default": "frozen_work_attempt",
          "title": "Budget Source",
          "type": "string"
        }
      },
      "required": [
        "candidate_revision",
        "previous_qa_artifact_id",
        "previous_qa_sha256",
        "previous_run_id",
        "previous_context_manifest_id",
        "invocation_outcome_sha256",
        "prerequisite_facts_sha256"
      ],
      "title": "VerificationRetryEvidence",
      "type": "object"
    },
    "VerifierPreparationEvidence": {
      "additionalProperties": false,
      "description": "Exact pre-model native execution facts, never an inferred provider failure.",
      "properties": {
        "candidate_revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Candidate Revision",
          "type": "string"
        },
        "preparation_checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Preparation Checkpoint Sha256",
          "type": "string"
        },
        "previous_run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Previous Run Id",
          "type": "string"
        },
        "previous_context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Previous Context Manifest Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "native_execution_state": {
          "enum": [
            "NOT_STARTED",
            "FINISHED"
          ],
          "title": "Native Execution State",
          "type": "string"
        },
        "native_binding_plan_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Binding Plan Sha256"
        },
        "native_started_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Started Sha256"
        },
        "native_finished_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Finished Sha256"
        },
        "native_failure_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Failure Code"
        },
        "prerequisite_facts_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prerequisite Facts Sha256",
          "type": "string"
        },
        "budget_source": {
          "anyOf": [
            {
              "const": "frozen_work_attempt",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Source"
        }
      },
      "required": [
        "candidate_revision",
        "preparation_checkpoint_sha256",
        "previous_run_id",
        "previous_context_manifest_id",
        "request_sha256",
        "native_execution_state",
        "prerequisite_facts_sha256"
      ],
      "title": "VerifierPreparationEvidence",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "native_execution_state": {
                "const": "FINISHED"
              }
            }
          },
          "then": {
            "required": [
              "native_binding_plan_sha256",
              "native_started_sha256",
              "native_finished_sha256",
              "budget_source"
            ],
            "properties": {
              "native_binding_plan_sha256": {
                "type": "string"
              },
              "native_started_sha256": {
                "type": "string"
              },
              "native_finished_sha256": {
                "type": "string"
              },
              "budget_source": {
                "const": "frozen_work_attempt"
              }
            }
          },
          "else": {
            "properties": {
              "native_started_sha256": {
                "type": "null"
              },
              "native_finished_sha256": {
                "type": "null"
              },
              "native_failure_code": {
                "type": "null"
              },
              "budget_source": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
