{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.dev/schemas/knowledge-index-chunk-cache.schema.json",
  "$defs": {
    "KnowledgeChunk": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "$ref": "#/$defs/KnowledgeCitation"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "section_path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "content": {
          "maxLength": 4096,
          "title": "Content",
          "type": "string"
        },
        "terms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "citation",
        "title",
        "ordinal",
        "content"
      ],
      "title": "KnowledgeChunk",
      "type": "object"
    },
    "KnowledgeCitation": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "pattern": "^[a-z][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Document Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "team",
            "project",
            "repository",
            "spec"
          ],
          "title": "Scope",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "chunk_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "chunk_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Chunk Sha256",
          "type": "string"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "scope",
        "document_sha256",
        "chunk_id",
        "chunk_sha256",
        "source_uri"
      ],
      "title": "KnowledgeCitation",
      "type": "object"
    },
    "KnowledgeDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "pattern": "^[a-z][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Document Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "team",
            "project",
            "repository",
            "spec"
          ],
          "title": "Scope",
          "type": "string"
        },
        "team_id": {
          "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Team Id",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "repository_ids": {
          "default": [],
          "items": {
            "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "title": "Repository Ids",
          "type": "array"
        },
        "roles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TeamRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "content": {
          "maxLength": 1000000,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "scope",
        "team_id",
        "title",
        "source_uri",
        "document_sha256",
        "content"
      ],
      "title": "KnowledgeDocument",
      "type": "object"
    },
    "TeamRole": {
      "description": "Long-lived roles that a Team-owned AgentProfile may declare.",
      "enum": [
        "manager",
        "product",
        "designer",
        "planner",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "TeamRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v0.1",
      "default": "v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "cache_key": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cache Key",
      "type": "string"
    },
    "parser_version": {
      "pattern": "^[a-zA-Z0-9._-]{1,40}$",
      "title": "Parser Version",
      "type": "string"
    },
    "index_version": {
      "pattern": "^[a-zA-Z0-9._-]{1,40}$",
      "title": "Index Version",
      "type": "string"
    },
    "document": {
      "$ref": "#/$defs/KnowledgeDocument"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/KnowledgeChunk"
      },
      "maxItems": 1024,
      "title": "Chunks",
      "type": "array"
    },
    "cache_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cache Sha256",
      "type": "string"
    }
  },
  "required": [
    "cache_key",
    "parser_version",
    "index_version",
    "document",
    "chunks",
    "cache_sha256"
  ],
  "title": "KnowledgeChunkCache",
  "type": "object"
}
