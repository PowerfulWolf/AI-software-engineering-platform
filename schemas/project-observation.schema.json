{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/project-observation.schema.json",
  "title": "Evidence-backed project observation proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "title", "fact", "applicability", "evidence_ids"],
  "properties": {
    "observation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "fact": {"type": "string", "minLength": 1, "maxLength": 4000},
    "applicability": {"type": "string", "minLength": 1, "maxLength": 1000},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ev_[a-z0-9][a-z0-9_-]{2,63}$"}}
  }
}
