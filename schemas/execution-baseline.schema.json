{
  "$defs": {
    "BaselineInputMode": {
      "enum": [
        "preserve_draft",
        "coder_reapply"
      ],
      "title": "BaselineInputMode",
      "type": "string"
    },
    "EngineeringScope": {
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "repository_id": {
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        },
        "repository_root": {
          "minLength": 1,
          "title": "Repository Root",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "project_id",
        "repository_id",
        "repository_root"
      ],
      "title": "EngineeringScope",
      "type": "object"
    },
    "RetainedExecutionPatch": {
      "additionalProperties": false,
      "description": "Reference to complete old execution-base → candidate + dirty mutation bodies.\n\nTrusted collection must validate the body and URI before this reference is\npublished. A digest alone never permits discarding a dirty worktree.",
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "maximum": 8000000,
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "uri",
        "sha256",
        "bytes"
      ],
      "title": "RetainedExecutionPatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One completed source rebind, never a role verdict or a new Product approval.",
  "properties": {
    "kind": {
      "const": "execution_baseline_binding",
      "default": "execution_baseline_binding",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/EngineeringScope"
    },
    "task_id": {
      "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
      "title": "Task Id",
      "type": "string"
    },
    "task_intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Intent Sha256",
      "type": "string"
    },
    "sequence": {
      "maximum": 100,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "previous_binding_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Binding Sha256"
    },
    "approved_base_ref": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "title": "Approved Base Ref",
      "type": "string"
    },
    "branch_name": {
      "maxLength": 240,
      "minLength": 11,
      "pattern": "^ai/(feature|bugfix)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Branch Name",
      "type": "string"
    },
    "worktree_path": {
      "minLength": 1,
      "title": "Worktree Path",
      "type": "string"
    },
    "prior_execution_base_ref": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "title": "Prior Execution Base Ref",
      "type": "string"
    },
    "prior_source_revision": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "title": "Prior Source Revision",
      "type": "string"
    },
    "execution_base_ref": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "title": "Execution Base Ref",
      "type": "string"
    },
    "execution_source_revision": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "title": "Execution Source Revision",
      "type": "string"
    },
    "input_mode": {
      "$ref": "#/$defs/BaselineInputMode"
    },
    "superseded_implementation_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded Implementation Artifact Id"
    },
    "superseded_progress_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded Progress Artifact Id"
    },
    "source_artifact_ids": {
      "items": {
        "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
        "type": "string"
      },
      "title": "Source Artifact Ids",
      "type": "array"
    },
    "resolved_interruption_receipt_sha256s": {
      "default": [],
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Resolved Interruption Receipt Sha256S",
      "type": "array"
    },
    "retained_patch": {
      "$ref": "#/$defs/RetainedExecutionPatch"
    },
    "authority_source": {
      "enum": [
        "organization_engineering_policy",
        "engineering_operator_decision"
      ],
      "title": "Authority Source",
      "type": "string"
    },
    "authority_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authority Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "facts_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Facts Sha256",
      "type": "string"
    },
    "prior_task_revision": {
      "minimum": 1,
      "title": "Prior Task Revision",
      "type": "integer"
    },
    "before_inventory_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Before Inventory Sha256",
      "type": "string"
    },
    "after_inventory_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "After Inventory Sha256",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "binding_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Binding Sha256",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "task_id",
    "task_intent_sha256",
    "sequence",
    "approved_base_ref",
    "branch_name",
    "worktree_path",
    "prior_execution_base_ref",
    "prior_source_revision",
    "execution_base_ref",
    "execution_source_revision",
    "input_mode",
    "source_artifact_ids",
    "retained_patch",
    "authority_source",
    "authority_sha256",
    "plan_sha256",
    "facts_sha256",
    "prior_task_revision",
    "before_inventory_sha256",
    "after_inventory_sha256",
    "completed_at",
    "binding_sha256"
  ],
  "title": "ExecutionBaselineBinding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/execution-baseline.schema.json"
}
