{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/implementation-report.schema.json",
  "title": "Implementation report artifact",
  "allOf": [
    {"$ref": "artifact.schema.json"},
    {
      "type": "object",
      "properties": {
        "kind": {"const": "implementation-report"},
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit_sha", "changed_files", "acceptance_mapping", "tests_run", "known_risks"],
          "properties": {
            "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
            "changed_files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "change", "lines_added", "lines_deleted"], "properties": {"path": {"type": "string"}, "change": {"enum": ["added", "modified", "deleted", "renamed"]}, "lines_added": {"type": "integer", "minimum": 0}, "lines_deleted": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
            "acceptance_mapping": {"type": "array", "items": {"type": "object", "required": ["criterion_id", "implementation", "tests"], "properties": {"criterion_id": {"type": "string"}, "implementation": {"type": "string"}, "tests": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
            "tests_run": {"type": "array", "items": {"type": "object", "required": ["command", "status", "evidence_id"], "properties": {"command": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "evidence_id": {"type": "string"}, "duration_ms": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
            "known_risks": {"type": "array", "items": {"type": "string"}},
            "blocked_reason": {"type": "string"}
          }
        }
      }
    }
  ]
}
