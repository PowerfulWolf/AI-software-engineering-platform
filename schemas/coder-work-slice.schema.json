{
  "$defs": {
    "PlanExecutionWindow": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "serial_coder_window_v1",
          "default": "serial_coder_window_v1",
          "title": "Kind",
          "type": "string"
        },
        "hard_seconds": {
          "maximum": 3600,
          "minimum": 2,
          "title": "Hard Seconds",
          "type": "integer"
        },
        "finalization_reserve_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Finalization Reserve Seconds",
          "type": "integer"
        },
        "reserve_rework_attempts": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Reserve Rework Attempts",
          "type": "integer"
        }
      },
      "required": [
        "hard_seconds",
        "finalization_reserve_seconds"
      ],
      "title": "PlanExecutionWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "coder_work_slice_v1",
      "default": "coder_work_slice_v1",
      "title": "Kind",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "plan_artifact_id": {
      "minLength": 1,
      "title": "Plan Artifact Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/PlanExecutionWindow"
    },
    "authorized_work_remaining": {
      "minimum": 1,
      "title": "Authorized Work Remaining",
      "type": "integer"
    },
    "completed_step_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Completed Step Ids",
      "type": "array"
    },
    "selected_step_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected Step Ids",
      "type": "array"
    },
    "later_step_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Later Step Ids",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "attempt",
    "source_revision",
    "plan_artifact_id",
    "plan_sha256",
    "window",
    "authorized_work_remaining",
    "completed_step_ids",
    "selected_step_ids",
    "later_step_ids"
  ],
  "title": "CoderWorkSlice",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/coder-work-slice.schema.json"
}
