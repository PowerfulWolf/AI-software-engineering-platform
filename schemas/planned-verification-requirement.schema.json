{
  "$defs": {
    "PlannedVerificationInspection": {
      "additionalProperties": false,
      "description": "An explicit approved inspection target, never a test or verdict.",
      "properties": {
        "kind": {
          "enum": [
            "document",
            "source",
            "native_ui"
          ],
          "title": "Kind",
          "type": "string"
        },
        "paths": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "checklist": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Checklist",
          "type": "array"
        },
        "scenario_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Sha256"
        }
      },
      "required": [
        "kind",
        "checklist"
      ],
      "title": "PlannedVerificationInspection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "qa",
        "reviewer"
      ],
      "title": "Role",
      "type": "string"
    },
    "criterion_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Criterion Ids",
      "type": "array"
    },
    "argv": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Argv"
    },
    "inspection": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlannedVerificationInspection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification_levels": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Levels"
    },
    "planned_new_files": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Planned New Files",
      "type": "array"
    },
    "controlled_capability_kind": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Controlled Capability Kind"
    }
  },
  "required": [
    "id",
    "role",
    "criterion_ids"
  ],
  "title": "PlannedVerificationRequirement",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/planned-verification-requirement.schema.json"
}
