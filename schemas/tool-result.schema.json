{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/tool-result.schema.json",
  "title": "Typed Agent tool result",
  "description": "Immutable success or fail-closed refusal returned by the policy-bound tool registry.",
  "oneOf": [
    {"$ref": "#/$defs/readFile"},
    {"$ref": "#/$defs/writeFile"},
    {"$ref": "#/$defs/runCommand"},
    {"$ref": "#/$defs/rejected"}
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["run_id", "role", "operation_id"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$"},
        "role": {"enum": ["coder", "qa", "reviewer", "orchestrator"]},
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"}
      },
      "unevaluatedProperties": false
    },
    "readFile": {
      "type": "object",
      "required": ["run_id", "role", "operation_id", "result_kind", "status", "tool", "path", "content", "content_sha256", "bytes_read", "truncated"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$"},
        "role": {"enum": ["coder", "qa", "reviewer", "orchestrator"]},
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "result_kind": {"const": "read_file"},
        "status": {"const": "SUCCEEDED"},
        "tool": {"const": "read_file"},
        "path": {"type": "string", "minLength": 1},
        "content": {"type": "string"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes_read": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "writeFile": {
      "type": "object",
      "required": ["run_id", "role", "operation_id", "result_kind", "status", "tool", "path", "content_sha256", "bytes_written"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$"},
        "role": {"enum": ["coder", "qa", "reviewer", "orchestrator"]},
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "result_kind": {"const": "write_file"},
        "status": {"const": "SUCCEEDED"},
        "tool": {"const": "write_file"},
        "path": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes_written": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "runCommand": {
      "type": "object",
      "required": ["run_id", "role", "operation_id", "result_kind", "status", "tool", "command"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$"},
        "role": {"enum": ["coder", "qa", "reviewer", "orchestrator"]},
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "result_kind": {"const": "run_command"},
        "status": {"const": "SUCCEEDED"},
        "tool": {"const": "run_command"},
        "command": {"$ref": "#/$defs/command"}
      },
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "required": ["run_id", "role", "operation_id", "result_kind", "status", "tool", "rejected", "error_code", "error_message"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$"},
        "role": {"enum": ["coder", "qa", "reviewer", "orchestrator"]},
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "result_kind": {"const": "rejected"},
        "status": {"const": "REJECTED"},
        "tool": {"enum": ["read_file", "write_file", "run_command"]},
        "rejected": {"const": true},
        "error_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "error_message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["argv", "cwd", "returncode", "stdout", "stderr", "duration_ms", "stdout_truncated", "stderr_truncated"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "minLength": 1},
        "returncode": {"type": "integer"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "stdout_truncated": {"type": "boolean"},
        "stderr_truncated": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
