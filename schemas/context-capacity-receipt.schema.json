{
  "$defs": {
    "AgentPermissions": {
      "additionalProperties": false,
      "description": "The executable path, command, network, and state capabilities of an Agent.",
      "properties": {
        "read_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Read Paths",
          "type": "array"
        },
        "write_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Write Paths",
          "type": "array"
        },
        "commands": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "network": {
          "$ref": "#/$defs/NetworkAccess"
        },
        "can_change_state": {
          "default": false,
          "title": "Can Change State",
          "type": "boolean"
        },
        "can_merge": {
          "default": false,
          "title": "Can Merge",
          "type": "boolean"
        }
      },
      "required": [
        "read_paths",
        "write_paths",
        "commands",
        "network"
      ],
      "title": "AgentPermissions",
      "type": "object"
    },
    "AgentRequest": {
      "additionalProperties": false,
      "description": "Immutable input envelope supplied to one Agent adapter invocation.",
      "properties": {
        "run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "attempt": {
          "maximum": 400,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Context Manifest Id",
          "type": "string"
        },
        "input_artifact_ids": {
          "items": {
            "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "title": "Input Artifact Ids",
          "type": "array"
        },
        "permissions": {
          "$ref": "#/$defs/AgentPermissions"
        },
        "output_schema": {
          "minLength": 1,
          "title": "Output Schema",
          "type": "string"
        },
        "timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "work_slice": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoderWorkSlice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_baseline_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Baseline Sha256"
        },
        "execution_base_ref": {
          "anyOf": [
            {
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Base Ref"
        },
        "continuation_checkpoint_id": {
          "anyOf": [
            {
              "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation Checkpoint Id"
        },
        "continuation_changed_paths": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Continuation Changed Paths",
          "type": "array"
        },
        "expected_parent_artifact_ids": {
          "anyOf": [
            {
              "items": {
                "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Parent Artifact Ids"
        },
        "expected_supersedes_by_kind": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "propertyNames": {
                "$ref": "#/$defs/ArtifactKind"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Supersedes By Kind"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "role",
        "attempt",
        "source_revision",
        "context_manifest_id",
        "input_artifact_ids",
        "permissions",
        "output_schema",
        "timeout_seconds"
      ],
      "title": "AgentRequest",
      "type": "object"
    },
    "AgentRole": {
      "description": "Delivery-runtime roles bound to Task artifacts and state transitions.",
      "enum": [
        "orchestrator",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "plan",
        "coder-progress",
        "implementation-report",
        "qa-report",
        "review-report"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "CoderWorkSlice": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "coder_work_slice_v1",
          "default": "coder_work_slice_v1",
          "title": "Kind",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "plan_artifact_id": {
          "minLength": 1,
          "title": "Plan Artifact Id",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/PlanExecutionWindow"
        },
        "authorized_work_remaining": {
          "minimum": 1,
          "title": "Authorized Work Remaining",
          "type": "integer"
        },
        "completed_step_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Completed Step Ids",
          "type": "array"
        },
        "selected_step_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Selected Step Ids",
          "type": "array"
        },
        "later_step_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Later Step Ids",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "attempt",
        "source_revision",
        "plan_artifact_id",
        "plan_sha256",
        "window",
        "authorized_work_remaining",
        "completed_step_ids",
        "selected_step_ids",
        "later_step_ids"
      ],
      "title": "CoderWorkSlice",
      "type": "object"
    },
    "NetworkAccess": {
      "enum": [
        "none",
        "model_endpoint_only",
        "allowlist"
      ],
      "title": "NetworkAccess",
      "type": "string"
    },
    "PlanExecutionWindow": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "serial_coder_window_v1",
          "default": "serial_coder_window_v1",
          "title": "Kind",
          "type": "string"
        },
        "hard_seconds": {
          "maximum": 3600,
          "minimum": 2,
          "title": "Hard Seconds",
          "type": "integer"
        },
        "finalization_reserve_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Finalization Reserve Seconds",
          "type": "integer"
        },
        "reserve_rework_attempts": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Reserve Rework Attempts",
          "type": "integer"
        }
      },
      "required": [
        "hard_seconds",
        "finalization_reserve_seconds"
      ],
      "title": "PlanExecutionWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A future exact failed preparation or an explicitly retrospective observation.\n\nA legacy record never invents the missing AgentRequest, Run or final token count.\nNeither origin proves an invocation result, approves recovery or refunds work.",
  "properties": {
    "kind": {
      "const": "context_capacity_receipt",
      "default": "context_capacity_receipt",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "origin": {
      "enum": [
        "final_input",
        "legacy_terminal_context"
      ],
      "title": "Origin",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "task_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Sha256",
      "type": "string"
    },
    "task_intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Intent Sha256",
      "type": "string"
    },
    "task_revision": {
      "minimum": 0,
      "title": "Task Revision",
      "type": "integer"
    },
    "work_item_id": {
      "minLength": 1,
      "title": "Work Item Id",
      "type": "string"
    },
    "lease_id": {
      "minLength": 1,
      "title": "Lease Id",
      "type": "string"
    },
    "assignment_id": {
      "minLength": 1,
      "title": "Assignment Id",
      "type": "string"
    },
    "claim_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Claim Sha256",
      "type": "string"
    },
    "dispatch_sequence": {
      "minimum": 0,
      "title": "Dispatch Sequence",
      "type": "integer"
    },
    "checkpoint_sequence": {
      "minimum": 0,
      "title": "Checkpoint Sequence",
      "type": "integer"
    },
    "role": {
      "$ref": "#/$defs/AgentRole",
      "enum": [
        "coder",
        "qa",
        "reviewer"
      ]
    },
    "attempt": {
      "exclusiveMinimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "context_manifest_id": {
      "pattern": "^ctx_[a-f0-9]{64}$",
      "title": "Context Manifest Id",
      "type": "string"
    },
    "context_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "max_input_tokens": {
      "exclusiveMinimum": 0,
      "title": "Max Input Tokens",
      "type": "integer"
    },
    "context_input_tokens": {
      "minimum": 0,
      "title": "Context Input Tokens",
      "type": "integer"
    },
    "final_input_tokens": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Input Tokens"
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_baseline_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Baseline Sha256"
    },
    "provider_started": {
      "const": false,
      "default": false,
      "title": "Provider Started",
      "type": "boolean"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    }
  },
  "required": [
    "origin",
    "task_id",
    "task_sha256",
    "task_intent_sha256",
    "task_revision",
    "work_item_id",
    "lease_id",
    "assignment_id",
    "claim_sha256",
    "dispatch_sequence",
    "checkpoint_sequence",
    "role",
    "attempt",
    "source_revision",
    "context_manifest_id",
    "context_sha256",
    "max_input_tokens",
    "context_input_tokens",
    "observed_at",
    "receipt_sha256"
  ],
  "title": "ContextCapacityReceipt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/context-capacity-receipt.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "const": "final_input"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "required": [
          "request",
          "final_input_tokens"
        ],
        "properties": {
          "request": {
            "$ref": "#/$defs/AgentRequest"
          },
          "final_input_tokens": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "request": {
            "type": "null"
          },
          "final_input_tokens": {
            "type": "null"
          }
        }
      }
    }
  ]
}
