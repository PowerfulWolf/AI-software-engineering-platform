{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/project-workspace.schema.json",
  "title": "ProjectManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "team_id",
    "team_manifest_sha256",
    "project_id",
    "name",
    "project_root",
    "created_at",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "v0.2"},
    "team_id": {
      "type": "string",
      "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "team_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "project_root": {"type": "string", "pattern": "^/", "minLength": 2},
    "created_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
