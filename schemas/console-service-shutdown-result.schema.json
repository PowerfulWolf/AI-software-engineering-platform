{
  "$defs": {
    "ServiceState": {
      "enum": [
        "STARTING",
        "RUNNING",
        "DRAINING",
        "READY",
        "REFUSED"
      ],
      "title": "ServiceState",
      "type": "string"
    },
    "ShutdownRefusal": {
      "additionalProperties": false,
      "description": "Safe, bounded explanation for a refused drain; never contains raw errors.",
      "properties": {
        "component": {
          "enum": [
            "WRITE_GATE",
            "CONSOLE",
            "KNOWLEDGE_INDEX",
            "OWNED_PROCESSES",
            "LIFECYCLE"
          ],
          "title": "Component",
          "type": "string"
        },
        "reason": {
          "enum": [
            "TIMEOUT",
            "UNCONFIRMED",
            "COMPONENT_ERROR"
          ],
          "title": "Reason",
          "type": "string"
        },
        "active_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Count"
        }
      },
      "required": [
        "component",
        "reason"
      ],
      "title": "ShutdownRefusal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "pattern": "^console_shutdown_[a-f0-9]{32}$",
      "title": "Request Id",
      "type": "string"
    },
    "instance_id": {
      "pattern": "^console_instance_[a-f0-9]{32}$",
      "title": "Instance Id",
      "type": "string"
    },
    "pid": {
      "exclusiveMinimum": 1,
      "title": "Pid",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/ServiceState"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "safe_summary": {
      "title": "Safe Summary",
      "type": "string"
    },
    "refusal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShutdownRefusal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "request_id",
    "instance_id",
    "pid",
    "state",
    "recorded_at",
    "safe_summary"
  ],
  "title": "ServiceShutdownResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/console-service-shutdown-result.schema.json"
}
