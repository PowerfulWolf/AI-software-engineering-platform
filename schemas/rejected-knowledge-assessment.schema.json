{
  "$defs": {
    "AgentRole": {
      "description": "Delivery-runtime roles bound to Task artifacts and state transitions.",
      "enum": [
        "orchestrator",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "BrainTier": {
      "enum": [
        "economy",
        "standard",
        "reasoning",
        "critical"
      ],
      "title": "BrainTier",
      "type": "string"
    },
    "CodexConnectionMode": {
      "enum": [
        "direct",
        "proxy"
      ],
      "type": "string"
    },
    "DeliveryDisposition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "delivery_disposition",
          "default": "delivery_disposition",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "facts": {
          "$ref": "#/$defs/DeliveryFailureFacts"
        },
        "source_facts_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Facts Sha256",
          "type": "string"
        },
        "responsibility": {
          "$ref": "#/$defs/DeliveryResponsibility"
        },
        "action": {
          "$ref": "#/$defs/DeliveryNextAction"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "next_action": {
          "minLength": 1,
          "title": "Next Action",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "resume_condition": {
          "enum": [
            "fresh_role_claim",
            "product_resolution",
            "engineering_authorization",
            "verified_prerequisites",
            "verified_execution_resolution",
            "explicit_baseline_continuation",
            "none"
          ],
          "title": "Resume Condition",
          "type": "string"
        }
      },
      "required": [
        "facts",
        "source_facts_sha256",
        "responsibility",
        "action",
        "reason",
        "next_action",
        "resume_condition"
      ],
      "title": "DeliveryDisposition",
      "type": "object"
    },
    "DeliveryFailureFacts": {
      "additionalProperties": false,
      "description": "Facts from trusted application services, never model routing suggestions.",
      "properties": {
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "work_item_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Item Id"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "classification": {
          "enum": [
            "TRANSIENT_INFRA",
            "NONTRANSIENT_INFRA",
            "INVALID_OUTPUT",
            "QA_FINDING",
            "VERIFICATION_INCONCLUSIVE",
            "REVIEW_FINDING",
            "POLICY_VIOLATION",
            "REQUIREMENT_AMBIGUITY",
            "BUDGET_EXHAUSTED",
            "CONTEXT_CAPACITY",
            "PLATFORM_BUG",
            "EXECUTION_UNCERTAIN",
            "ENVIRONMENT_UNAVAILABLE",
            "ENGINEERING_AUTHORIZATION",
            "SOURCE_PREPARATION_DRIFT",
            "EXECUTION_BASELINE_PAUSED",
            "KNOWLEDGE_PREPARATION_LIMIT",
            "SERVICE_PAUSED"
          ],
          "title": "Classification",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "task_intent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Task Intent Sha256",
          "type": "string"
        },
        "checkpoint_sequence": {
          "minimum": 0,
          "title": "Checkpoint Sequence",
          "type": "integer"
        },
        "budget_available": {
          "title": "Budget Available",
          "type": "boolean"
        },
        "retry_authorized": {
          "default": false,
          "title": "Retry Authorized",
          "type": "boolean"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "execution_baseline_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Baseline Sha256"
        }
      },
      "required": [
        "task_id",
        "role",
        "classification",
        "source_revision",
        "task_intent_sha256",
        "checkpoint_sequence",
        "budget_available"
      ],
      "title": "DeliveryFailureFacts",
      "type": "object"
    },
    "DeliveryNextAction": {
      "enum": [
        "RETRY",
        "REMEDIATE_CANDIDATE",
        "REQUEST_PRODUCT_DECISION",
        "REQUEST_ENGINEERING_AUTHORIZATION",
        "WAIT_DEPENDENCY",
        "INVESTIGATE_EXECUTION",
        "RESUME_EXECUTION_BASELINE",
        "TERMINATE"
      ],
      "title": "DeliveryNextAction",
      "type": "string"
    },
    "DeliveryResponsibility": {
      "enum": [
        "product",
        "team",
        "engineering"
      ],
      "title": "DeliveryResponsibility",
      "type": "string"
    },
    "KnowledgeCitation": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "pattern": "^[a-z][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Document Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "team",
            "project",
            "repository",
            "spec"
          ],
          "title": "Scope",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "chunk_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "chunk_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Chunk Sha256",
          "type": "string"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "scope",
        "document_sha256",
        "chunk_id",
        "chunk_sha256",
        "source_uri"
      ],
      "title": "KnowledgeCitation",
      "type": "object"
    },
    "KnowledgeRunBinding": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "role": {
          "$ref": "#/$defs/TeamRole"
        },
        "team_id": {
          "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Team Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "repository_ids": {
          "items": {
            "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Repository Ids",
          "type": "array"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Context Manifest Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "role",
        "team_id",
        "project_id",
        "requirement_id",
        "repository_ids",
        "source_revision",
        "context_manifest_id",
        "snapshot_sha256"
      ],
      "title": "KnowledgeRunBinding",
      "type": "object"
    },
    "KnowledgeRunManifest": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/KnowledgeRunBinding"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/KnowledgeCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "snapshot_sha256",
        "evidence_ids",
        "citations",
        "manifest_sha256"
      ],
      "title": "KnowledgeRunManifest",
      "type": "object"
    },
    "ModelRouteReason": {
      "enum": [
        "default",
        "task_complexity",
        "risk_floor",
        "role_floor",
        "context_capacity",
        "objective_escalation",
        "budget_constraint",
        "operator_override"
      ],
      "title": "ModelRouteReason",
      "type": "string"
    },
    "ModelSelection": {
      "additionalProperties": false,
      "description": "Concrete, run-scoped model allocation with machine-readable reasons.",
      "properties": {
        "kind": {
          "const": "model_selection",
          "default": "model_selection",
          "title": "Kind",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^model_policy_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "route_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRouteKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "connection_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodexConnectionMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tier": {
          "$ref": "#/$defs/BrainTier"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/ModelRouteReason"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "selected_at": {
          "format": "date-time",
          "title": "Selected At",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "provider",
        "model",
        "tier",
        "reasons",
        "selected_at"
      ],
      "title": "ModelSelection",
      "type": "object"
    },
    "ProviderRouteKind": {
      "enum": [
        "codex_cli",
        "responses"
      ],
      "type": "string"
    },
    "QueueClaim": {
      "additionalProperties": false,
      "description": "Durable assignment/model/Lease bundle returned to one worker.",
      "properties": {
        "kind": {
          "const": "queue_claim",
          "default": "queue_claim",
          "title": "Kind",
          "type": "string"
        },
        "work_item": {
          "$ref": "#/$defs/QueuedWorkItem"
        },
        "assignment": {
          "$ref": "#/$defs/RoleAssignment"
        },
        "lease": {
          "$ref": "#/$defs/TaskLease"
        },
        "model_selection": {
          "$ref": "#/$defs/ModelSelection"
        },
        "worker_id": {
          "pattern": "^worker_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Worker Id",
          "type": "string"
        },
        "claimed_at": {
          "format": "date-time",
          "title": "Claimed At",
          "type": "string"
        }
      },
      "required": [
        "work_item",
        "assignment",
        "lease",
        "model_selection",
        "worker_id",
        "claimed_at"
      ],
      "title": "QueueClaim",
      "type": "object"
    },
    "QueuedWorkItem": {
      "additionalProperties": false,
      "description": "One executable delivery-role Run in the organization queue.",
      "properties": {
        "kind": {
          "const": "work_item",
          "default": "work_item",
          "title": "Kind",
          "type": "string"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Repository Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/WorkItemStatus"
        },
        "priority": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "risk": {
          "$ref": "#/$defs/RiskTier"
        },
        "required_capabilities": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "preferred_agent_id": {
          "anyOf": [
            {
              "pattern": "^agent_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Agent Id"
        },
        "wait_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Reason"
        },
        "wait_disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryDisposition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "id": {
          "pattern": "^work_[a-z0-9][a-z0-9_-]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "attempt": {
          "maximum": 400,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "checkpoint_sequence": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Checkpoint Sequence",
          "type": "integer"
        },
        "dispatch_sequence": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Dispatch Sequence",
          "type": "integer"
        },
        "repository_scopes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Repository Scopes",
          "type": "array"
        },
        "parent_work_item_id": {
          "anyOf": [
            {
              "pattern": "^work_[a-z0-9][a-z0-9_-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Work Item Id"
        }
      },
      "required": [
        "task_id",
        "repository_id",
        "status",
        "priority",
        "risk",
        "created_at",
        "updated_at",
        "id",
        "role",
        "attempt",
        "repository_scopes"
      ],
      "title": "QueuedWorkItem",
      "type": "object"
    },
    "ReasoningEffort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "type": "string"
    },
    "RiskTier": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "title": "RiskTier",
      "type": "string"
    },
    "RoleAssignment": {
      "additionalProperties": false,
      "description": "Temporary binding of an organization Agent to one Task role and lease.",
      "properties": {
        "kind": {
          "const": "role_assignment",
          "default": "role_assignment",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^assignment_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Repository Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "agent_id": {
          "pattern": "^agent_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Agent Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "attempt": {
          "maximum": 400,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "lease_id": {
          "pattern": "^lease_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Lease Id",
          "type": "string"
        },
        "capacity_units": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Capacity Units",
          "type": "integer"
        },
        "assigned_at": {
          "format": "date-time",
          "title": "Assigned At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "repository_id",
        "task_id",
        "agent_id",
        "role",
        "attempt",
        "lease_id",
        "assigned_at"
      ],
      "title": "RoleAssignment",
      "type": "object"
    },
    "TaskLease": {
      "additionalProperties": false,
      "description": "Expiring claim on Agent capacity for one RoleAssignment.",
      "properties": {
        "kind": {
          "const": "task_lease",
          "default": "task_lease",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^lease_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "assignment_id": {
          "pattern": "^assignment_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Assignment Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "agent_id": {
          "pattern": "^agent_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Agent Id",
          "type": "string"
        },
        "capacity_units": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Capacity Units",
          "type": "integer"
        },
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "assignment_id",
        "task_id",
        "agent_id",
        "acquired_at",
        "expires_at"
      ],
      "title": "TaskLease",
      "type": "object"
    },
    "TeamRole": {
      "description": "Long-lived roles that a Team-owned AgentProfile may declare.",
      "enum": [
        "manager",
        "product",
        "designer",
        "planner",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "TeamRole",
      "type": "string"
    },
    "WorkItemStatus": {
      "enum": [
        "READY",
        "LEASED",
        "RUNNING",
        "WAITING_HUMAN",
        "WAITING_DEPENDENCY",
        "RETRY_SCHEDULED",
        "CLOSED"
      ],
      "title": "WorkItemStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "rejected_knowledge_assessment",
      "default": "rejected_knowledge_assessment",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "v0.1",
      "default": "v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/KnowledgeRunBinding"
    },
    "input_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "original_claim": {
      "$ref": "#/$defs/QueueClaim"
    },
    "original_claim_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Original Claim Sha256",
      "type": "string"
    },
    "intent_outcome_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intent Outcome Sha256",
