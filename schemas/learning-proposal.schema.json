{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/learning-proposal.schema.json",
  "title": "LearningProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "proposal_id", "team_id", "project_id", "trigger", "recurrence_key",
    "occurrence_count", "title", "observation", "proposed_improvement", "verification",
    "suggested_target", "evidence", "created_at", "proposal_sha256"
  ],
  "properties": {
    "schema_version": {"const": "v0.1", "default": "v0.1"},
    "proposal_id": {"type": "string", "pattern": "^learning_proposal_[a-f0-9]{32}$"},
    "team_id": {"type": "string", "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$"},
    "project_id": {"type": "string", "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$"},
    "trigger": {"enum": ["QA_FAILURE", "REVIEW_REJECTION"]},
    "recurrence_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "occurrence_count": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "observation": {"type": "string", "minLength": 1},
    "proposed_improvement": {"type": "string", "minLength": 1},
    "verification": {"type": "string", "minLength": 1},
    "suggested_target": {"enum": ["KNOWLEDGE", "SPEC", "SKILL"]},
    "evidence": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "repository_id", "task_id", "artifact_id", "artifact_sha256", "finding_id",
          "evidence_uris"
        ],
        "properties": {
          "repository_id": {"type": "string", "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$"},
          "task_id": {"type": "string", "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$"},
          "artifact_id": {"type": "string", "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$"},
          "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "finding_id": {"type": "string", "minLength": 1},
          "evidence_uris": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "proposal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
