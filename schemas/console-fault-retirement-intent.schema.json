{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "kind": {
      "const": "exact_host_fault_termination_intent",
      "default": "exact_host_fault_termination_intent",
      "title": "Kind",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "principal_uid": {
      "minimum": 0,
      "title": "Principal Uid",
      "type": "integer"
    },
    "signal": {
      "const": "SIGKILL",
      "default": "SIGKILL",
      "title": "Signal",
      "type": "string"
    },
    "successor_mode": {
      "const": "inspection",
      "default": "inspection",
      "title": "Successor Mode",
      "type": "string"
    }
  },
  "required": [
    "recorded_at",
    "record_sha256",
    "plan_sha256",
    "principal_uid"
  ],
  "title": "TerminationIntent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
