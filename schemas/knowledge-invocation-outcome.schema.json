{
  "$defs": {
    "AgentErrorCode": {
      "description": "Stable failure categories consumed by Orchestrator retry routing.",
      "enum": [
        "TIMEOUT",
        "QUOTA_EXHAUSTED",
        "RATE_LIMITED",
        "AUTHENTICATION_ERROR",
        "PROVIDER_UNAVAILABLE",
        "INVALID_OUTPUT",
        "PROVIDER_ERROR",
        "POLICY_VIOLATION",
        "WORK_INTERRUPTED"
      ],
      "title": "AgentErrorCode",
      "type": "string"
    },
    "AgentRole": {
      "description": "Delivery-runtime roles bound to Task artifacts and state transitions.",
      "enum": [
        "orchestrator",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "AgentUsage": {
      "additionalProperties": false,
      "description": "Provider-neutral token usage reported for one Agent Run.",
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "title": "AgentUsage",
      "type": "object"
    },
    "BrainTier": {
      "enum": [
        "economy",
        "standard",
        "reasoning",
        "critical"
      ],
      "title": "BrainTier",
      "type": "string"
    },
    "CodexConnectionMode": {
      "enum": [
        "direct",
        "proxy"
      ],
      "type": "string"
    },
    "DeliveryDisposition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "delivery_disposition",
          "default": "delivery_disposition",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "facts": {
          "$ref": "#/$defs/DeliveryFailureFacts"
        },
        "source_facts_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Facts Sha256",
          "type": "string"
        },
        "responsibility": {
          "$ref": "#/$defs/DeliveryResponsibility"
        },
        "action": {
          "$ref": "#/$defs/DeliveryNextAction"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "next_action": {
          "minLength": 1,
          "title": "Next Action",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "resume_condition": {
          "enum": [
            "fresh_role_claim",
            "product_resolution",
            "engineering_authorization",
            "verified_prerequisites",
            "verified_execution_resolution",
            "explicit_baseline_continuation",
            "none"
          ],
          "title": "Resume Condition",
          "type": "string"
        }
      },
      "required": [
        "facts",
        "source_facts_sha256",
        "responsibility",
        "action",
        "reason",
        "next_action",
        "resume_condition"
      ],
      "title": "DeliveryDisposition",
      "type": "object"
    },
    "DeliveryFailureFacts": {
      "additionalProperties": false,
      "description": "Facts from trusted application services, never model routing suggestions.",
      "properties": {
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "work_item_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Item Id"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "classification": {
          "enum": [
            "TRANSIENT_INFRA",
            "INVALID_OUTPUT",
            "QA_FINDING",
            "VERIFICATION_INCONCLUSIVE",
            "REVIEW_FINDING",
            "POLICY_VIOLATION",
            "REQUIREMENT_AMBIGUITY",
            "BUDGET_EXHAUSTED",
            "PLATFORM_BUG",
            "EXECUTION_UNCERTAIN",
            "ENVIRONMENT_UNAVAILABLE",
            "ENGINEERING_AUTHORIZATION",
            "SOURCE_PREPARATION_DRIFT",
            "EXECUTION_BASELINE_PAUSED",
            "KNOWLEDGE_PREPARATION_LIMIT"
          ],
          "title": "Classification",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "task_intent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Task Intent Sha256",
          "type": "string"
        },
        "checkpoint_sequence": {
          "minimum": 0,
          "title": "Checkpoint Sequence",
          "type": "integer"
        },
        "budget_available": {
          "title": "Budget Available",
          "type": "boolean"
        },
        "retry_authorized": {
          "default": false,
          "title": "Retry Authorized",
          "type": "boolean"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "execution_baseline_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Baseline Sha256"
        }
      },
      "required": [
        "task_id",
        "role",
        "classification",
        "source_revision",
        "task_intent_sha256",
        "checkpoint_sequence",
        "budget_available"
      ],
      "title": "DeliveryFailureFacts",
      "type": "object"
    },
    "DeliveryNextAction": {
      "enum": [
        "RETRY",
        "REMEDIATE_CANDIDATE",
        "REQUEST_PRODUCT_DECISION",
        "REQUEST_ENGINEERING_AUTHORIZATION",
        "WAIT_DEPENDENCY",
        "INVESTIGATE_EXECUTION",
        "RESUME_EXECUTION_BASELINE",
        "TERMINATE"
      ],
      "title": "DeliveryNextAction",
      "type": "string"
    },
    "DeliveryResponsibility": {
      "enum": [
        "product",
        "team",
        "engineering"
      ],
      "title": "DeliveryResponsibility",
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "KnowledgeExecutionRecord": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "knowledge_execution_record",
          "default": "knowledge_execution_record",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v0.1",
          "default": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "intent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Intent Sha256",
          "type": "string"
        },
        "observation": {
          "discriminator": {
            "mapping": {
              "structured_execution_admission": "#/$defs/StructuredExecutionAdmission",
              "structured_http_round_trip": "#/$defs/StructuredHttpRoundTripReceipt",
              "structured_native_not_started": "#/$defs/StructuredNativeNotStartedReceipt",
              "structured_native_stop": "#/$defs/StructuredNativeStopReceipt"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StructuredExecutionAdmission"
            },
            {
              "$ref": "#/$defs/StructuredNativeStopReceipt"
            },
            {
              "$ref": "#/$defs/StructuredNativeNotStartedReceipt"
            },
            {
              "$ref": "#/$defs/StructuredHttpRoundTripReceipt"
            }
          ],
          "title": "Observation"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "intent_sha256",
        "observation",
        "record_sha256"
      ],
      "title": "KnowledgeExecutionRecord",
      "type": "object"
    },
    "KnowledgeInvocationFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/AgentErrorCode"
        },
        "safe_message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Safe Message",
          "type": "string"
        },
        "transient": {
          "title": "Transient",
          "type": "boolean"
        },
        "timeout_kind": {
          "anyOf": [
            {
              "const": "local_execution_limit",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Kind"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "request_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "correlation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        }
      },
      "required": [
        "code",
        "safe_message",
        "transient"
      ],
      "title": "KnowledgeInvocationFailure",
      "type": "object"
    },
    "KnowledgeInvocationIntent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "knowledge_invocation_intent",
          "default": "knowledge_invocation_intent",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v0.1",
          "default": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/KnowledgeRunBinding"
        },
        "phase": {
          "enum": [
            "intent",
            "assessment"
          ],
          "title": "Phase",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueueClaim"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "intent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Intent Sha256",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "phase",
        "request_sha256",
        "timeout_seconds",
        "created_at",
        "intent_sha256"
      ],
      "title": "KnowledgeInvocationIntent",
      "type": "object"
    },
    "KnowledgeInvocationResult": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/WirePayload"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "request_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "correlation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        }
      },
      "required": [
        "payload",
        "duration_ms"
      ],
      "title": "KnowledgeInvocationResult",
      "type": "object"
    },
    "KnowledgeRunBinding": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "role": {
          "$ref": "#/$defs/TeamRole"
        },
        "team_id": {
          "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Team Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "repository_ids": {
          "items": {
            "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Repository Ids",
          "type": "array"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Context Manifest Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "role",
        "team_id",
        "project_id",
        "requirement_id",
        "repository_ids",
        "source_revision",
        "context_manifest_id",
        "snapshot_sha256"
      ],
      "title": "KnowledgeRunBinding",
      "type": "object"
    },
    "ModelRouteReason": {
      "enum": [
        "default",
        "task_complexity",
        "risk_floor",
        "role_floor",
        "context_capacity",
        "objective_escalation",
        "budget_constraint",
        "operator_override"
      ],
      "title": "ModelRouteReason",
      "type": "string"
    },
    "ModelSelection": {
      "additionalProperties": false,
      "description": "Concrete, run-scoped model allocation with machine-readable reasons.",
      "properties": {
        "kind": {
          "const": "model_selection",
          "default": "model_selection",
          "title": "Kind",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^model_policy_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "route_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRouteKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "connection_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodexConnectionMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tier": {
          "$ref": "#/$defs/BrainTier"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/ModelRouteReason"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "selected_at": {
          "format": "date-time",
          "title": "Selected At",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "provider",
        "model",
        "tier",
        "reasons",
        "selected_at"
      ],
      "title": "ModelSelection",
      "type": "object"
    },
    "NativeProcessStop": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "completed"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "returncode": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "failed"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "returncode": {
                "not": {
                  "const": 0
                }
              }
            }
          }
        }
      ],
      "description": "Legacy leader/group stop, optionally with a new explicit owned-SID proof.",
      "properties": {
        "process_id": {
          "exclusiveMinimum": 0,
          "title": "Process Id",
          "type": "integer"
        },
        "group_id": {
          "exclusiveMinimum": 0,
          "title": "Group Id",
          "type": "integer"
        },
        "returncode": {
          "title": "Returncode",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "completed",
            "failed",
            "local_execution_limit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "stopped_at": {
          "format": "date-time",
          "title": "Stopped At",
          "type": "string"
        },
        "stop_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Stop Sha256",
          "type": "string"
        },
        "session_proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/OwnedSessionStopProof"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "process_id",
        "group_id",
        "returncode",
        "kind",
        "stopped_at",
        "stop_sha256"
      ],
      "title": "NativeProcessStop",
      "type": "object"
    },
    "ProviderRouteKind": {
      "enum": [
        "codex_cli",
        "responses"
      ],
      "type": "string"
    },
    "QueueClaim": {
      "additionalProperties": false,
      "description": "Durable assignment/model/Lease bundle returned to one worker.",
      "properties": {
        "kind": {
          "const": "queue_claim",
          "default": "queue_claim",
          "title": "Kind",
          "type": "string"
        },
        "work_item": {
          "$ref": "#/$defs/QueuedWorkItem"
        },
        "assignment": {
          "$ref": "#/$defs/RoleAssignment"
        },
        "lease": {
          "$ref": "#/$defs/TaskLease"
        },
        "model_selection": {
          "$ref": "#/$defs/ModelSelection"
        },
        "worker_id": {
          "pattern": "^worker_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Worker Id",
          "type": "string"
        },
        "claimed_at": {
          "format": "date-time",
          "title": "Claimed At",
          "type": "string"
        }
      },
      "required": [
        "work_item",
        "assignment",
        "lease",
        "model_selection",
        "worker_id",
        "claimed_at"
      ],
      "title": "QueueClaim",
      "type": "object"
    },
    "QueuedWorkItem": {
      "additionalProperties": false,
      "description": "One executable delivery-role Run in the organization queue.",
      "properties": {
        "kind": {
          "const": "work_item",
          "default": "work_item",
          "title": "Kind",
          "type": "string"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Repository Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/WorkItemStatus"
        },
        "priority": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "risk": {
          "$ref": "#/$defs/RiskTier"
        },
        "required_capabilities": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "preferred_agent_id": {
          "anyOf": [
            {
              "pattern": "^agent_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
