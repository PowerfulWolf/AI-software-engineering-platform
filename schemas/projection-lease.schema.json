{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/projection-lease.schema.json",
  "title": "Lease projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["lease_id", "assignment_id", "task_id", "agent_id", "capacity_units", "acquired_at", "expires_at", "status"],
  "properties": {
    "lease_id": {"type": "string", "minLength": 1},
    "assignment_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$"},
    "agent_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["orchestrator", "coder", "qa", "reviewer"]},
    "capacity_units": {"type": "integer", "minimum": 1},
    "acquired_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["UNKNOWN", "ACTIVE", "EXPIRED"]}
  }
}
