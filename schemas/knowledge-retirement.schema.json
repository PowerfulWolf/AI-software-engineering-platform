{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/knowledge-retirement.schema.json",
  "title": "KnowledgeRetirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "team_id",
    "retired_document_ids",
    "retirement_sha256"
  ],
  "properties": {
    "schema_version": { "const": "v0.1", "default": "v0.1" },
    "scope": { "enum": ["team", "project"] },
    "team_id": {
      "type": "string",
      "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "retired_document_ids": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^knowledge_document_[a-f0-9]{32}$"
      }
    },
    "retirement_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "scope": { "const": "project" } },
        "required": ["scope"]
      },
      "then": { "required": ["project_id"] },
      "else": { "not": { "required": ["project_id"] } }
    }
  ]
}
