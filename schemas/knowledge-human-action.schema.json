{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/knowledge-human-action.schema.json",
  "$defs": {
    "KnowledgeResolution": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "knowledge_resolution",
          "default": "knowledge_resolution",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v0.1",
          "default": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "gap_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Gap Id",
          "type": "string"
        },
        "previous_run_id": {
          "minLength": 1,
          "title": "Previous Run Id",
          "type": "string"
        },
        "answer": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeResolutionSource"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "approval_reference": {
          "minLength": 1,
          "title": "Approval Reference",
          "type": "string"
        },
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "disposition": {
          "default": "REQUIREMENT_ONLY",
          "enum": [
            "REQUIREMENT_ONLY",
            "PROPOSE_LEARNING"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "resolution_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Resolution Id",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "previous_run_id",
        "answer",
        "sources",
        "approval_reference",
        "approved_by",
        "resolution_id"
      ],
      "title": "KnowledgeResolution",
      "type": "object"
    },
    "KnowledgeResolutionSource": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "content": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "content"
      ],
      "title": "KnowledgeResolutionSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "HumanActionEvent",
      "default": "HumanActionEvent",
      "title": "Kind",
      "type": "string"
    },
    "action": {
      "const": "APPROVE_KNOWLEDGE_RESOLUTION",
      "default": "APPROVE_KNOWLEDGE_RESOLUTION",
      "title": "Action",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "gap_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Gap Id",
      "type": "string"
    },
    "resolution": {
      "$ref": "#/$defs/KnowledgeResolution"
    },
    "actor": {
      "const": "human:local-console",
      "default": "human:local-console",
      "title": "Actor",
      "type": "string"
    },
    "event_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Event Sha256",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "requirement_id",
    "gap_id",
    "resolution",
    "event_sha256"
  ],
  "title": "KnowledgeHumanActionEvent",
  "type": "object"
}
