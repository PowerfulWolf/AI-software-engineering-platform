{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/knowledge-resume.schema.json",
  "$defs": {
    "KnowledgeRunBinding": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "role": {
          "$ref": "#/$defs/TeamRole"
        },
        "team_id": {
          "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Team Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "repository_ids": {
          "items": {
            "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Repository Ids",
          "type": "array"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Context Manifest Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "role",
        "team_id",
        "project_id",
        "requirement_id",
        "repository_ids",
        "source_revision",
        "context_manifest_id",
        "snapshot_sha256"
      ],
      "title": "KnowledgeRunBinding",
      "type": "object"
    },
    "TeamRole": {
      "description": "Long-lived roles that a Team-owned AgentProfile may declare.",
      "enum": [
        "manager",
        "product",
        "designer",
        "planner",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "TeamRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "gap_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Gap Id",
      "type": "string"
    },
    "resolution_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Resolution Id",
      "type": "string"
    },
    "previous_binding": {
      "$ref": "#/$defs/KnowledgeRunBinding"
    },
    "new_binding": {
      "$ref": "#/$defs/KnowledgeRunBinding"
    },
    "previous_resume_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Resume Sha256"
    },
    "resume_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Resume Sha256",
      "type": "string"
    }
  },
  "required": [
    "gap_id",
    "resolution_id",
    "previous_binding",
    "new_binding",
    "resume_sha256"
  ],
  "title": "KnowledgeResume",
  "type": "object"
}
