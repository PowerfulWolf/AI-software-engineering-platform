{
  "$defs": {
    "CloseRequirementIntent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "CLOSE_REQUIREMENT",
          "default": "CLOSE_REQUIREMENT",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "delivery_id": {
          "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "expected_checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Checkpoint Sha256",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "delivery_id",
        "expected_checkpoint_sha256"
      ],
      "title": "CloseRequirementIntent",
      "type": "object"
    },
    "ConsoleApprovalRequest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "candidate_verification",
            "coder_recovery",
            "coder_interruption",
            "pre_execution_restart",
            "coder_scope",
            "joint_integration",
            "prerequisite_repair"
          ],
          "title": "Kind",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "facts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Facts",
          "type": "array"
        },
        "coder_scope_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryScopeRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "plan_sha256",
        "title",
        "facts"
      ],
      "title": "ConsoleApprovalRequest",
      "type": "object",
      "allOf": [
        {
          "if": {
            "required": [
              "coder_scope_request"
            ],
            "properties": {
              "coder_scope_request": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "coder_scope"
              }
            }
          }
        }
      ]
    },
    "ConsoleCommandResult": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "delivery_id": {
          "anyOf": [
            {
              "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Id"
        },
        "checkpoint_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Sha256"
        },
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "next_action": {
          "minLength": 1,
          "title": "Next Action",
          "type": "string"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsoleApprovalRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "project_id",
        "stage",
        "next_action"
      ],
      "title": "ConsoleCommandResult",
      "type": "object",
      "oneOf": [
        {
          "required": [
            "delivery_id",
            "checkpoint_sha256"
          ],
          "properties": {
            "delivery_id": {
              "type": "string"
            },
            "checkpoint_sha256": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "delivery_id": {
              "type": "null"
            },
            "checkpoint_sha256": {
              "type": "null"
            },
            "approval": {
              "type": "null"
            }
          }
        }
      ]
    },
    "ConsoleOperationStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "INTERRUPTED"
      ],
      "title": "ConsoleOperationStatus",
      "type": "string"
    },
