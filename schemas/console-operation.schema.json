    "NativeUiScenario": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Product",
          "type": "string"
        },
        "mock_argument": {
          "pattern": "^--mock-[a-z][a-z0-9-]{0,70}$",
          "title": "Mock Argument",
          "type": "string"
        },
        "window_title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Window Title",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/NativeUiStep"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "product",
        "mock_argument",
        "window_title",
        "steps"
      ],
      "title": "NativeUiScenario",
      "type": "object"
    },
    "NativeUiStep": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "action": {
          "default": "snapshot",
          "enum": [
            "snapshot",
            "press",
            "scroll"
          ],
          "title": "Action",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "AXButton",
                "AXCheckBox",
                "AXLink"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "attribute": {
          "anyOf": [
            {
              "enum": [
                "AXTitle",
                "AXDescription",
                "AXIdentifier"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "index": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "capture_window": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Window"
        },
        "scroll_position": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scroll Position"
        }
      },
      "required": [
        "name"
      ],
      "title": "NativeUiStep",
      "type": "object"
    },
