    "CreateRequirementIntent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "CREATE_REQUIREMENT",
          "default": "CREATE_REQUIREMENT",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "repository_roots": {
          "items": {
            "minLength": 1,
            "type": "string",
            "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]*$"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Repository Roots",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "project_id",
        "name",
        "repository_roots"
      ],
      "title": "CreateRequirementIntent",
      "type": "object"
    },
    "DeleteRequirementIntent": {
