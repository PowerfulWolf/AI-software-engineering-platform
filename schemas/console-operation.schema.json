          "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "expected_checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Checkpoint Sha256",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 20000,
          "title": "Message",
          "type": "string"
        },
        "screenshot_ids": {
          "default": [],
          "items": {
            "pattern": "^requirement_attachment_[a-f0-9]{40}$",
            "type": "string"
          },
          "maxItems": 4,
          "title": "Screenshot Ids",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "project_id",
        "delivery_id",
        "expected_checkpoint_sha256"
      ],
      "title": "ProductReplyIntent",
      "type": "object",
      "anyOf": [
        {
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "pattern": "\\S"
            }
          }
        },
        {
          "required": [
            "screenshot_ids"
          ],
          "properties": {
            "screenshot_ids": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "PytestSelection": {
      "additionalProperties": false,
      "description": "A specific test function/class method, possibly parametrized; never a suite root.",
      "properties": {
        "node_id": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^tests/(?:[A-Za-z0-9_][A-Za-z0-9_.-]*/)*test_[A-Za-z0-9_.-]+\\.py::[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)?(?:\\[[A-Za-z0-9_.-]+\\])?$",
          "title": "Node Id",
          "type": "string"
        },
        "criterion_ids": {
          "items": {
            "pattern": "^ac_[a-z0-9][a-z0-9_-]{1,63}$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Criterion Ids",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "criterion_ids"
      ],
      "title": "PytestSelection",
      "type": "object"
    },
    "RecheckDesignIntent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "RECHECK_DESIGN",
          "default": "RECHECK_DESIGN",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "delivery_id": {
          "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "expected_checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Checkpoint Sha256",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "delivery_id",
        "expected_checkpoint_sha256"
      ],
      "title": "RecheckDesignIntent",
      "type": "object"
    },
    "RecoverDesignIntent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "RECOVER_DESIGN",
          "default": "RECOVER_DESIGN",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "delivery_id": {
          "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "expected_checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Checkpoint Sha256",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "delivery_id",
        "expected_checkpoint_sha256"
      ],
      "title": "RecoverDesignIntent",
      "type": "object"
    },
    "RecoveryScopeRequest": {
      "additionalProperties": false,
      "description": "Operator-selected exact missing files, bound to accepted Coder progress.",
      "properties": {
        "progress_artifact_id": {
          "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Progress Artifact Id",
          "type": "string"
        },
        "progress_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Progress Sha256",
          "type": "string"
        },
        "paths": {
          "items": {
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Paths",
          "type": "array",
          "uniqueItems": true
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "progress_artifact_id",
        "progress_sha256",
        "paths",
        "reason"
      ],
      "title": "RecoveryScopeRequest",
      "type": "object"
    },
    "RestartRequirementIntent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "RESTART_REQUIREMENT",
          "default": "RESTART_REQUIREMENT",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "delivery_id": {
          "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "expected_checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Checkpoint Sha256",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "delivery_id",
        "expected_checkpoint_sha256"
      ],
      "title": "RestartRequirementIntent",
      "type": "object"
    },
    "UpdateRequirementIntent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "UPDATE_REQUIREMENT",
          "default": "UPDATE_REQUIREMENT",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "delivery_id": {
          "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "expected_checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Checkpoint Sha256",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "repository_roots": {
          "items": {
            "minLength": 1,
            "type": "string",
            "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]*$"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Repository Roots",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "project_id",
        "delivery_id",
        "expected_checkpoint_sha256",
        "name",
        "repository_roots"
      ],
      "title": "UpdateRequirementIntent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v0.2",
      "default": "v0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^operation_[a-f0-9]{32}$",
      "title": "Operation Id",
      "type": "string"
    },
    "team_id": {
      "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
      "title": "Team Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent": {
      "discriminator": {
        "mapping": {
          "CLOSE_REQUIREMENT": "#/$defs/CloseRequirementIntent",
          "CONTINUE_DELIVERY": "#/$defs/ContinueDeliveryIntent",
          "CREATE_PROJECT": "#/$defs/CreateProjectIntent",
          "CREATE_REQUIREMENT": "#/$defs/CreateRequirementIntent",
          "DELETE_REQUIREMENT": "#/$defs/DeleteRequirementIntent",
          "PRODUCT_APPROVAL": "#/$defs/ProductApprovalIntent",
          "PRODUCT_REPLY": "#/$defs/ProductReplyIntent",
          "RECHECK_DESIGN": "#/$defs/RecheckDesignIntent",
          "RECOVER_DESIGN": "#/$defs/RecoverDesignIntent",
          "RESTART_REQUIREMENT": "#/$defs/RestartRequirementIntent",
          "UPDATE_REQUIREMENT": "#/$defs/UpdateRequirementIntent"
        },
        "propertyName": "action"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CreateProjectIntent"
        },
        {
          "$ref": "#/$defs/CreateRequirementIntent"
        },
        {
          "$ref": "#/$defs/UpdateRequirementIntent"
        },
        {
          "$ref": "#/$defs/CloseRequirementIntent"
        },
        {
          "$ref": "#/$defs/RestartRequirementIntent"
        },
        {
          "$ref": "#/$defs/DeleteRequirementIntent"
        },
        {
          "$ref": "#/$defs/ProductReplyIntent"
        },
        {
          "$ref": "#/$defs/ProductApprovalIntent"
        },
        {
          "$ref": "#/$defs/ContinueDeliveryIntent"
        },
        {
          "$ref": "#/$defs/RecoverDesignIntent"
        },
        {
          "$ref": "#/$defs/RecheckDesignIntent"
        }
      ],
      "title": "Intent"
    },
    "intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ConsoleOperationStatus"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "previous_operation_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Operation Sha256"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConsoleCommandResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "error_summary": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Summary"
    },
    "operation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Operation Sha256",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "team_id",
    "idempotency_key",
    "intent",
    "intent_sha256",
    "status",
    "sequence",
    "requested_at",
    "updated_at",
    "operation_sha256"
  ],
  "title": "ConsoleOperation",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "sequence": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "QUEUED"
          },
          "previous_operation_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "previous_operation_sha256"
        ],
        "properties": {
          "previous_operation_sha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "null"
          },
          "error_code": {
            "type": "null"
          },
          "error_summary": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object"
          },
          "error_code": {
            "type": "null"
          },
          "error_summary": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAILED",
              "INTERRUPTED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "error_code",
          "error_summary"
        ],
        "properties": {
          "result": {
            "type": "null"
          },
          "error_code": {
            "type": "string"
          },
          "error_summary": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/console-operation.schema.json"
}
