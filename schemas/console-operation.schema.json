    "CreateProjectIntent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "CREATE_PROJECT",
          "default": "CREATE_PROJECT",
          "title": "Action",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
