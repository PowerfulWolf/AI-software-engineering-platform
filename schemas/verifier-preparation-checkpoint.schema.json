{
  "$defs": {
    "AgentPermissions": {
      "additionalProperties": false,
      "description": "The executable path, command, network, and state capabilities of an Agent.",
      "properties": {
        "read_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Read Paths",
          "type": "array"
        },
        "write_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Write Paths",
          "type": "array"
        },
        "commands": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "network": {
          "$ref": "#/$defs/NetworkAccess"
        },
        "can_change_state": {
          "default": false,
          "title": "Can Change State",
          "type": "boolean"
        },
        "can_merge": {
          "default": false,
          "title": "Can Merge",
          "type": "boolean"
        }
      },
      "required": [
        "read_paths",
        "write_paths",
        "commands",
        "network"
      ],
      "title": "AgentPermissions",
      "type": "object"
    },
    "AgentRequest": {
      "additionalProperties": false,
      "description": "Immutable input envelope supplied to one Agent adapter invocation.",
      "properties": {
        "run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "attempt": {
          "maximum": 400,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Context Manifest Id",
          "type": "string"
        },
        "input_artifact_ids": {
          "items": {
            "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "title": "Input Artifact Ids",
          "type": "array"
        },
        "permissions": {
          "$ref": "#/$defs/AgentPermissions"
        },
        "output_schema": {
          "minLength": 1,
          "title": "Output Schema",
          "type": "string"
        },
        "timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "work_slice": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoderWorkSlice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_baseline_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Baseline Sha256"
        },
        "execution_base_ref": {
          "anyOf": [
            {
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Base Ref"
        },
        "continuation_checkpoint_id": {
          "anyOf": [
            {
              "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation Checkpoint Id"
        },
        "continuation_changed_paths": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Continuation Changed Paths",
          "type": "array"
        },
        "expected_parent_artifact_ids": {
          "anyOf": [
            {
              "items": {
                "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Parent Artifact Ids"
        },
        "expected_supersedes_by_kind": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "propertyNames": {
                "$ref": "#/$defs/ArtifactKind"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Supersedes By Kind"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "role",
        "attempt",
        "source_revision",
        "context_manifest_id",
        "input_artifact_ids",
        "permissions",
        "output_schema",
        "timeout_seconds"
      ],
      "title": "AgentRequest",
      "type": "object"
    },
    "AgentRole": {
      "description": "Delivery-runtime roles bound to Task artifacts and state transitions.",
      "enum": [
        "orchestrator",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "plan",
        "coder-progress",
        "implementation-report",
        "qa-report",
        "review-report"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "CoderWorkSlice": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "coder_work_slice_v1",
          "default": "coder_work_slice_v1",
          "title": "Kind",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "plan_artifact_id": {
          "minLength": 1,
          "title": "Plan Artifact Id",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/PlanExecutionWindow"
        },
        "authorized_work_remaining": {
          "minimum": 1,
          "title": "Authorized Work Remaining",
          "type": "integer"
        },
        "completed_step_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Completed Step Ids",
          "type": "array"
        },
        "selected_step_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Selected Step Ids",
          "type": "array"
        },
        "later_step_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Later Step Ids",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "attempt",
        "source_revision",
        "plan_artifact_id",
        "plan_sha256",
        "window",
        "authorized_work_remaining",
        "completed_step_ids",
        "selected_step_ids",
        "later_step_ids"
      ],
      "title": "CoderWorkSlice",
      "type": "object"
    },
    "NativeVerificationWaitReason": {
      "enum": [
        "LEGACY_VERIFICATION_AUTHORITY_REQUIRED",
        "CONTROLLED_VERIFICATION_ENTRYPOINT_UNSUPPORTED",
        "CONTROLLED_SWIFT_FILTER_UNSUPPORTED",
        "CONTROLLED_NATIVE_UI_PREREQUISITE_REQUIRED",
        "CONTROLLED_VERIFICATION_CAPABILITY_UNAVAILABLE",
        "CONTROLLED_VERIFICATION_FACTS_CHANGED",
        "CONTROLLED_VERIFICATION_EXECUTION_UNCERTAIN",
        "CONTROLLED_VERIFICATION_COMMAND_TIMEOUT",
        "CONTROLLED_VERIFICATION_COMMAND_START_FAILED"
      ],
      "title": "NativeVerificationWaitReason",
      "type": "string"
    },
    "NetworkAccess": {
      "enum": [
        "none",
        "model_endpoint_only",
        "allowlist"
      ],
      "title": "NetworkAccess",
      "type": "string"
    },
    "PlanExecutionWindow": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "serial_coder_window_v1",
          "default": "serial_coder_window_v1",
          "title": "Kind",
          "type": "string"
        },
        "hard_seconds": {
          "maximum": 3600,
          "minimum": 2,
          "title": "Hard Seconds",
          "type": "integer"
        },
        "finalization_reserve_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Finalization Reserve Seconds",
          "type": "integer"
        },
        "reserve_rework_attempts": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Reserve Rework Attempts",
          "type": "integer"
        }
      },
      "required": [
        "hard_seconds",
        "finalization_reserve_seconds"
      ],
      "title": "PlanExecutionWindow",
      "type": "object"
    },
    "VerifierPreparationObservation": {
      "additionalProperties": false,
      "properties": {
        "native_execution_state": {
          "enum": [
            "NOT_STARTED",
            "FINISHED",
            "UNCERTAIN"
          ],
          "title": "Native Execution State",
          "type": "string"
        },
        "native_binding_plan_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Binding Plan Sha256"
        },
        "native_started_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Started Sha256"
        },
        "native_finished_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Finished Sha256"
        },
        "native_failure_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Failure Code"
        }
      },
      "required": [
        "native_execution_state"
      ],
      "title": "VerifierPreparationObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "verifier_preparation_checkpoint",
      "default": "verifier_preparation_checkpoint",
      "title": "Kind",
      "type": "string"
    },
    "work_item_id": {
      "minLength": 1,
      "title": "Work Item Id",
      "type": "string"
    },
    "lease_id": {
      "minLength": 1,
      "title": "Lease Id",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "task_snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Snapshot Sha256",
      "type": "string"
    },
    "checkpoint_sequence": {
      "minimum": 0,
      "title": "Checkpoint Sequence",
      "type": "integer"
    },
    "dispatch_sequence": {
      "minimum": 0,
      "title": "Dispatch Sequence",
      "type": "integer"
    },
    "wait_dispatch_sequence": {
      "minimum": 0,
      "title": "Wait Dispatch Sequence",
      "type": "integer"
    },
    "wait_lease_id": {
      "minLength": 1,
      "title": "Wait Lease Id",
      "type": "string"
    },
    "intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Revision",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "qa",
        "reviewer"
      ],
      "title": "Role",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "context_manifest_id": {
      "minLength": 1,
      "title": "Context Manifest Id",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/AgentRequest"
    },
    "result": {
      "enum": [
        "READY",
        "WAIT"
      ],
      "title": "Result",
      "type": "string"
    },
    "observation": {
      "$ref": "#/$defs/VerifierPreparationObservation"
    },
    "failure_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeVerificationWaitReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "checkpoint_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checkpoint Sha256",
      "type": "string"
    }
  },
  "required": [
    "work_item_id",
    "lease_id",
    "task_id",
    "task_snapshot_sha256",
    "checkpoint_sequence",
    "dispatch_sequence",
    "wait_dispatch_sequence",
    "wait_lease_id",
    "intent_sha256",
    "source_revision",
    "run_id",
    "role",
    "attempt",
    "context_manifest_id",
    "request_sha256",
    "request",
    "result",
    "observation",
    "checked_at",
    "checkpoint_sha256"
  ],
  "title": "VerifierPreparationCheckpoint",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/verifier-preparation-checkpoint.schema.json"
}
