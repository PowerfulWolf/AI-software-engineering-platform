  "additionalProperties": false,
  "description": "Immutable typed output; success and failure states are mutually exclusive.",
  "properties": {
    "run_id": {
      "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
      "title": "Task Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/AgentRole"
    },
    "attempt": {
      "maximum": 400,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "context_manifest_id": {
      "pattern": "^ctx_[a-f0-9]{64}$",
      "title": "Context Manifest Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentRunStatus"
    },
    "artifact": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "coder-progress": "#/$defs/CoderProgressArtifact",
              "implementation-report": "#/$defs/ImplementationReportArtifact",
              "plan": "#/$defs/PlanArtifact",
              "qa-report": "#/$defs/QaReportArtifact",
              "review-report": "#/$defs/ReviewReportArtifact"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PlanArtifact"
            },
            {
              "$ref": "#/$defs/CoderProgressArtifact"
            },
            {
              "$ref": "#/$defs/ImplementationReportArtifact"
            },
            {
              "$ref": "#/$defs/QaReportArtifact"
            },
            {
              "$ref": "#/$defs/ReviewReportArtifact"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "duration_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "role",
    "attempt",
    "source_revision",
    "context_manifest_id",
    "status"
  ],
  "title": "AgentResult",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "required": [
          "artifact"
        ],
        "properties": {
          "artifact": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object"
          },
          "artifact": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "TIMED_OUT"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "TIMEOUT"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "TIMEOUT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "TIMED_OUT"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "WORK_INTERRUPTED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/agent-result.schema.json"
}
