{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-engineer.local/schemas/tool-request.schema.json",
  "title": "Typed Agent tool request",
  "description": "A role-scoped request. Shell source and verdict mutation are not part of this wire contract.",
  "oneOf": [
    {"$ref": "#/$defs/readFile"},
    {"$ref": "#/$defs/writeFile"},
    {"$ref": "#/$defs/runCommand"}
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["run_id", "role", "operation_id"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$"},
        "role": {"enum": ["coder", "qa", "reviewer", "orchestrator"]},
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"}
      },
      "additionalProperties": false
    },
    "path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "readFile": {
      "type": "object",
      "required": ["run_id", "role", "operation_id", "tool", "path"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$"},
        "role": {"enum": ["coder", "qa", "reviewer", "orchestrator"]},
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "tool": {"const": "read_file"},
        "path": {"$ref": "#/$defs/path"},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 10000000, "default": 1000000}
      },
      "additionalProperties": false
    },
    "writeFile": {
      "type": "object",
      "required": ["run_id", "role", "operation_id", "tool", "path", "content"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$"},
        "role": {"enum": ["coder", "qa", "reviewer", "orchestrator"]},
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "tool": {"const": "write_file"},
        "path": {"$ref": "#/$defs/path"},
        "content": {"type": "string"}
      },
      "additionalProperties": false
    },
    "runCommand": {
      "type": "object",
      "required": ["run_id", "role", "operation_id", "tool", "argv"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$"},
        "role": {"enum": ["coder", "qa", "reviewer", "orchestrator"]},
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "tool": {"const": "run_command"},
        "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      },
      "additionalProperties": false
    }
  }
}
