{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "description": "One independently verifiable condition for Task delivery.",
      "properties": {
        "id": {
          "pattern": "^ac_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "verification": {
          "minLength": 1,
          "title": "Verification",
          "type": "string"
        },
        "test_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Test Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "required",
        "verification"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "AgentRole": {
      "description": "Delivery-runtime roles bound to Task artifacts and state transitions.",
      "enum": [
        "orchestrator",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "CancellationTaskInventory": {
      "additionalProperties": false,
      "description": "The original Task and queue facts, before any cancellation writes.",
      "properties": {
        "task": {
          "$ref": "#/$defs/Task"
        },
        "repository_id": {
          "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Repository Id",
          "type": "string"
        },
        "task_snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Task Snapshot Sha256",
          "type": "string"
        },
        "state_revision": {
          "minimum": 0,
          "title": "State Revision",
          "type": "integer"
        },
        "state_events_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "State Events Sha256",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "queue_items": {
          "items": {
            "$ref": "#/$defs/QueuedWorkItem"
          },
          "title": "Queue Items",
          "type": "array"
        },
        "queue_inventory_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Queue Inventory Sha256",
          "type": "string"
        }
      },
      "required": [
        "task",
        "repository_id",
        "task_snapshot_sha256",
        "state_revision",
        "state_events_sha256",
        "source_revision",
        "queue_items",
        "queue_inventory_sha256"
      ],
      "title": "CancellationTaskInventory",
      "type": "object"
    },
    "DeliveryRetryFailure": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "coder",
            "qa",
            "reviewer"
          ],
          "title": "Role",
          "type": "string"
        },
        "attempt": {
          "maximum": 400,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "code": {
          "enum": [
            "TIMEOUT",
            "QUOTA_EXHAUSTED",
            "RATE_LIMITED",
            "PROVIDER_UNAVAILABLE"
          ],
          "title": "Code",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "role",
        "attempt",
        "code"
      ],
      "title": "DeliveryRetryFailure",
      "type": "object"
    },
    "DeliveryRetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_work_attempts": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Work Attempts",
          "type": "integer"
        },
        "coder": {
          "$ref": "#/$defs/TransientRetryPolicy",
          "default": {
            "max_transient_failures": 5
          }
        },
        "qa": {
          "$ref": "#/$defs/TransientRetryPolicy",
          "default": {
            "max_transient_failures": 5
          }
        },
        "reviewer": {
          "$ref": "#/$defs/TransientRetryPolicy",
          "default": {
            "max_transient_failures": 5
          }
        }
      },
      "title": "DeliveryRetryPolicy",
      "type": "object"
    },
    "InterruptionContinuationPolicy": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "capability_id": {
                "const": "git-regular-text-mutation-inventory-v2"
              },
              "allowed_changes": {
                "const": [
                  "text_added",
                  "text_modified",
                  "text_deleted",
                  "regular_mode_changed"
                ]
              }
            },
            "required": [
              "capability_id",
              "allowed_changes"
            ]
          },
          "if": {
            "properties": {
              "schema_version": {
                "const": "v1"
              }
            }
          },
          "then": {
            "properties": {
              "capability_id": {
                "const": "git-text-mutation-inventory-v1"
              },
              "max_continuations": {
                "const": 1
              },
              "allowed_changes": {
                "const": [
                  "text_added",
                  "text_modified"
                ]
              }
            }
          }
        }
      ],
      "description": "Frozen narrow capability; legacy Tasks have no implicit authorization.",
      "properties": {
        "kind": {
          "const": "interruption_continuation_policy",
          "default": "interruption_continuation_policy",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": "v1",
          "enum": [
            "v1",
            "v2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "authorization_source": {
          "const": "organization_engineering_policy",
          "default": "organization_engineering_policy",
          "title": "Authorization Source",
          "type": "string"
        },
        "capability_id": {
          "default": "git-text-mutation-inventory-v1",
          "enum": [
            "git-text-mutation-inventory-v1",
            "git-regular-text-mutation-inventory-v2"
          ],
          "title": "Capability Id",
          "type": "string"
        },
        "max_continuations": {
          "default": 1,
          "maximum": 199,
          "minimum": 1,
          "title": "Max Continuations",
          "type": "integer"
        },
        "allowed_causes": {
          "default": [
            "local_execution_limit",
            "provider_transient"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "local_execution_limit",
              "type": "string"
            },
            {
              "const": "provider_transient",
              "type": "string"
            }
          ],
          "title": "Allowed Causes",
          "type": "array"
        },
        "allowed_changes": {
          "default": [
            "text_added",
            "text_modified"
          ],
          "items": {
            "enum": [
              "text_added",
              "text_modified",
              "text_deleted",
              "regular_mode_changed"
            ],
            "type": "string"
          },
          "title": "Allowed Changes",
          "type": "array"
        }
      },
      "title": "InterruptionContinuationPolicy",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "QueuedWorkItem": {
      "additionalProperties": false,
      "description": "One executable delivery-role Run in the organization queue.",
      "properties": {
        "kind": {
          "const": "work_item",
          "default": "work_item",
          "title": "Kind",
          "type": "string"
        },
        "task_id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Repository Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/WorkItemStatus"
        },
        "priority": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "risk": {
          "$ref": "#/$defs/RiskTier"
        },
        "required_capabilities": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "preferred_agent_id": {
          "anyOf": [
            {
              "pattern": "^agent_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Agent Id"
        },
        "wait_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Reason"
        },
        "available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "id": {
          "pattern": "^work_[a-z0-9][a-z0-9_-]{2,95}$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "attempt": {
          "maximum": 400,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "checkpoint_sequence": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Checkpoint Sequence",
          "type": "integer"
        },
        "dispatch_sequence": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Dispatch Sequence",
          "type": "integer"
        },
        "repository_scopes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Repository Scopes",
          "type": "array"
        },
        "parent_work_item_id": {
          "anyOf": [
            {
              "pattern": "^work_[a-z0-9][a-z0-9_-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Work Item Id"
        }
      },
      "required": [
        "task_id",
        "repository_id",
        "status",
        "priority",
        "risk",
        "created_at",
        "updated_at",
        "id",
        "role",
        "attempt",
        "repository_scopes"
      ],
      "title": "QueuedWorkItem",
      "type": "object"
    },
    "RequirementCancellationHumanAction": {
      "additionalProperties": false,
      "description": "The explicit product deletion command, never an Agent approval.",
      "properties": {
        "kind": {
          "const": "HumanActionEvent",
          "default": "HumanActionEvent",
          "title": "Kind",
          "type": "string"
        },
        "action": {
          "const": "DELETE_REQUIREMENT",
          "default": "DELETE_REQUIREMENT",
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "const": "operator:local-console",
          "default": "operator:local-console",
          "title": "Actor",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "expected_checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Checkpoint Sha256",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "requirement_id",
        "expected_checkpoint_sha256",
        "requested_at"
      ],
      "title": "RequirementCancellationHumanAction",
      "type": "object"
    },
    "RiskTier": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "title": "RiskTier",
      "type": "string"
    },
    "Task": {
      "additionalProperties": false,
      "description": "A bounded request tied to one repository and delivery state.",
      "properties": {
        "id": {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "base_ref": {
          "minLength": 1,
          "title": "Base Ref",
          "type": "string"
        },
        "branch_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 11,
              "pattern": "^ai/(feature|bugfix)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch Name"
        },
        "acceptance_criteria": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "constraints": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskConstraints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "max_attempts": {
          "maximum": 400,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "attempts": {
          "default": 0,
          "maximum": 400,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "owner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "labels": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "retry_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryRetryPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retry_failures": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DeliveryRetryFailure"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Failures"
        },
        "interruption_continuation_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterruptionContinuationPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "engineering_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EngineeringPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "repository",
        "base_ref",
        "acceptance_criteria",
        "status",
        "max_attempts",
        "created_at",
        "updated_at"
      ],
      "title": "Task",
      "type": "object"
    },
    "TaskConstraints": {
      "additionalProperties": false,
      "description": "Machine-consumable restrictions attached to a Task.",
      "properties": {
        "allowed_paths": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Paths",
          "type": "array"
        },
        "denied_paths": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Denied Paths",
          "type": "array"
        },
        "allowed_commands": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Commands",
          "type": "array"
        },
        "max_attempts": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Attempts"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "TaskConstraints",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "NEW",
        "PLANNING",
        "IMPLEMENTING",
        "CONTINUE_REQUIRED",
        "QUEUED",
        "QA",
        "REVIEW",
        "DONE",
        "BLOCKED",
        "FAILED"
      ],
      "title": "TaskStatus",
      "type": "string"
    },
    "TransientRetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_transient_failures": {
          "default": 5,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Transient Failures",
          "type": "integer"
        }
      },
      "title": "TransientRetryPolicy",
      "type": "object"
    },
    "WorkItemStatus": {
      "enum": [
        "READY",
        "LEASED",
        "RUNNING",
        "WAITING_HUMAN",
        "WAITING_DEPENDENCY",
        "RETRY_SCHEDULED",
        "CLOSED"
      ],
      "title": "WorkItemStatus",
      "type": "string"
    },
    "EngineeringCapability": {
      "enum": [
        "verification_refresh",
        "swift_sandbox",
        "python_mysql_sandbox",
        "native_ui_sandbox",
        "in_scope_prerequisite_repair",
        "pre_execution_rebind",
        "execution_baseline_rebind",
        "owned_mysql_cleanup"
      ],
      "title": "EngineeringCapability",
      "type": "string"
    },
    "EngineeringGrant": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "#/$defs/EngineeringCapability"
        },
        "max_admissions": {
          "maximum": 20,
          "minimum": 1,
          "title": "Max Admissions",
          "type": "integer"
        }
      },
      "required": [
        "capability",
        "max_admissions"
      ],
      "title": "EngineeringGrant",
      "type": "object"
    },
    "EngineeringPolicy": {
      "additionalProperties": false,
      "description": "Versioned organization decision frozen only on newly admitted Tasks.",
      "properties": {
        "kind": {
          "const": "engineering_policy",
          "default": "engineering_policy",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "policy_id": {
          "default": "local-bounded-engineering-v1",
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "default": 1,
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "authorization_source": {
          "const": "organization_engineering_policy",
          "default": "organization_engineering_policy",
          "title": "Authorization Source",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EngineeringScope"
        },
        "issued_by": {
          "$ref": "#/$defs/LocalOperatorPrincipal"
        },
        "grants": {
          "items": {
            "$ref": "#/$defs/EngineeringGrant"
          },
          "minItems": 1,
          "title": "Grants",
          "type": "array"
        },
        "max_total_admissions": {
          "default": 12,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Total Admissions",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "issued_by",
        "grants"
      ],
      "title": "EngineeringPolicy",
      "type": "object"
    },
    "EngineeringScope": {
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "repository_id": {
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        },
        "repository_root": {
          "minLength": 1,
          "title": "Repository Root",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "project_id",
        "repository_id",
        "repository_root"
      ],
      "title": "EngineeringScope",
      "type": "object"
    },
    "LocalOperatorPrincipal": {
      "additionalProperties": false,
      "description": "Trusted local composition identity; request/model text cannot add duties.",
      "properties": {
        "kind": {
          "const": "trusted_local_operator",
          "default": "trusted_local_operator",
