{
  "$defs": {
    "AgentRole": {
      "description": "Delivery-runtime roles bound to Task artifacts and state transitions.",
      "enum": [
        "orchestrator",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "AgentView": {
      "additionalProperties": false,
      "properties": {
        "assigned_delivery_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assigned Delivery Ids",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "current_stage_delivery_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Current Stage Delivery Ids",
          "type": "array"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "execution_liveness": {
          "const": "UNKNOWN",
          "default": "UNKNOWN",
          "title": "Execution Liveness",
          "type": "string"
        },
        "history_delivery_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "History Delivery Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "max_parallel_assignments": {
          "title": "Max Parallel Assignments",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/TeamRole"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "roles",
        "capabilities",
        "enabled",
        "max_parallel_assignments"
      ],
      "title": "AgentView",
      "type": "object"
    },
    "AssignmentView": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "current_stage": {
          "title": "Current Stage",
          "type": "boolean"
        },
        "planned_model": {
          "title": "Planned Model",
          "type": "string"
        },
        "planned_provider": {
          "title": "Planned Provider",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        }
      },
      "required": [
        "agent_id",
        "role",
        "planned_provider",
        "planned_model",
        "current_stage"
      ],
      "title": "AssignmentView",
      "type": "object"
    },
    "CodexConnectionMode": {
      "enum": [
        "direct",
        "proxy"
      ],
      "type": "string"
    },
    "DesignBudget": {
      "additionalProperties": false,
      "description": "Read-only observation; unknown legacy transient counts default to zero.",
      "properties": {
        "design_attempts": {
          "minimum": 0,
          "title": "Design Attempts",
          "type": "integer"
        },
        "exhausted": {
          "anyOf": [
            {
              "enum": [
                "design",
                "transient"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exhausted"
        },
        "max_design_attempts": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Design Attempts",
          "type": "integer"
        },
        "max_transient_failures": {
          "default": 5,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Transient Failures",
          "type": "integer"
        },
        "transient_failures": {
          "minimum": 0,
          "title": "Transient Failures",
          "type": "integer"
        }
      },
      "required": [
        "design_attempts",
        "transient_failures"
      ],
      "title": "DesignBudget",
      "type": "object"
    },
    "DialogueAttachmentView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "source_bytes": {
          "title": "Source Bytes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "media_type",
        "source_bytes",
        "sha256"
      ],
      "title": "DialogueAttachmentView",
      "type": "object"
    },
    "DialogueTurnView": {
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DialogueAttachmentView"
          },
          "title": "Attachments",
          "type": "array"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "speaker": {
          "enum": [
            "user",
            "product"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "speaker"
      ],
      "title": "DialogueTurnView",
      "type": "object"
    },
    "DocumentView": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "source_uri": {
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source_uri",
        "sha256"
      ],
      "title": "DocumentView",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "KnowledgeGap": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/KnowledgeRunBinding"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "gap_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Gap Id",
          "type": "string"
        },
        "impact": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "kind": {
          "const": "knowledge_gap",
          "default": "knowledge_gap",
          "title": "Kind",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "question": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "reason": {
          "enum": [
            "MISSING",
            "CONFLICT",
            "STALE",
            "UNVERIFIABLE"
          ],
          "title": "Reason",
          "type": "string"
        },
        "required_decision": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Required Decision",
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "schema_version": {
          "const": "v0.1",
          "default": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "BLOCKING",
            "NON_BLOCKING"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "question",
        "required_decision",
        "reason",
        "severity",
        "impact",
        "risk",
        "evidence_ids",
        "manifest_sha256",
        "gap_id"
      ],
      "title": "KnowledgeGap",
      "type": "object"
    },
    "KnowledgeGapView": {
      "additionalProperties": false,
      "properties": {
        "gap": {
          "$ref": "#/$defs/KnowledgeGap"
        },
        "is_current": {
          "title": "Is Current",
          "type": "boolean"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnowledgeResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "gap",
        "is_current"
      ],
      "title": "KnowledgeGapView",
      "type": "object"
    },
    "KnowledgeResolution": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "approval_reference": {
          "minLength": 1,
          "title": "Approval Reference",
          "type": "string"
        },
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "disposition": {
          "default": "REQUIREMENT_ONLY",
          "enum": [
            "REQUIREMENT_ONLY",
            "PROPOSE_LEARNING"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "gap_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Gap Id",
          "type": "string"
        },
        "kind": {
          "const": "knowledge_resolution",
          "default": "knowledge_resolution",
          "title": "Kind",
          "type": "string"
        },
        "previous_run_id": {
          "minLength": 1,
          "title": "Previous Run Id",
          "type": "string"
        },
        "resolution_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Resolution Id",
          "type": "string"
        },
        "schema_version": {
          "const": "v0.1",
          "default": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeResolutionSource"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "gap_id",
        "previous_run_id",
        "answer",
        "sources",
        "approval_reference",
        "approved_by",
        "resolution_id"
      ],
      "title": "KnowledgeResolution",
      "type": "object"
    },
    "KnowledgeResolutionSource": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "content"
      ],
      "title": "KnowledgeResolutionSource",
      "type": "object"
    },
    "KnowledgeRunBinding": {
      "additionalProperties": false,
      "properties": {
        "context_manifest_id": {
          "pattern": "^ctx_[a-f0-9]{64}$",
          "title": "Context Manifest Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "repository_ids": {
          "items": {
            "pattern": "^repository_[a-z0-9][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Repository Ids",
          "type": "array"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/TeamRole"
        },
        "run_id": {
          "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "team_id": {
          "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "role",
        "team_id",
        "project_id",
        "requirement_id",
        "repository_ids",
        "source_revision",
        "context_manifest_id",
        "snapshot_sha256"
      ],
      "title": "KnowledgeRunBinding",
      "type": "object"
    },
    "ProjectView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "repository_count": {
          "default": 0,
          "title": "Repository Count",
          "type": "integer"
        },
        "requirement_count": {
          "default": 0,
          "title": "Requirement Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectView",
      "type": "object"
    },
    "ProjectionEventKind": {
      "description": "Source fact types rendered in a timeline.",
      "enum": [
        "state_event",
        "evaluation_event",
        "artifact",
        "evidence",
        "handoff",
        "assignment",
        "lease"
      ],
      "title": "ProjectionEventKind",
      "type": "string"
    },
    "ProviderRouteKind": {
      "enum": [
        "codex_cli",
        "responses"
      ],
      "type": "string"
    },
    "RequestView": {
      "additionalProperties": false,
      "properties": {
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        },
        "checkpoint_sha256": {
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "design_budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/DesignBudget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "design_recheck_available": {
          "default": false,
          "title": "Design Recheck Available",
          "type": "boolean"
        },
        "design_recheck_pending": {
          "default": false,
          "title": "Design Recheck Pending",
          "type": "boolean"
        },
        "design_recovery_available": {
          "default": false,
          "title": "Design Recovery Available",
          "type": "boolean"
        },
        "dialogue": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DialogueTurnView"
          },
          "title": "Dialogue",
          "type": "array"
        },
        "failed_stages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Failed Stages",
          "type": "array"
        },
        "documents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DocumentView"
          },
          "title": "Documents",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "knowledge_gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnowledgeGapView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "knowledge_rechecked_gap_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Knowledge Rechecked Gap Ids",
          "type": "array"
        },
        "knowledge_wait_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Wait Stage"
        },
        "next_action": {
          "title": "Next Action",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/ScopeView"
          },
          "title": "Scopes",
          "type": "array"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "stage_budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageBudget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "title",
        "stage",
        "scopes",
        "next_action",
        "checkpoint_sha256"
      ],
      "title": "RequestView",
      "type": "object"
    },
    "RoleQueueView": {
      "additionalProperties": false,
