{
  "$defs": {
    "AgentRole": {
      "description": "Delivery-runtime roles bound to Task artifacts and state transitions.",
      "enum": [
        "orchestrator",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "AgentView": {
      "additionalProperties": false,
      "properties": {
        "assigned_delivery_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assigned Delivery Ids",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "current_stage_delivery_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Current Stage Delivery Ids",
          "type": "array"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "execution_liveness": {
          "const": "UNKNOWN",
          "default": "UNKNOWN",
          "title": "Execution Liveness",
          "type": "string"
        },
        "history_delivery_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "History Delivery Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "max_parallel_assignments": {
          "title": "Max Parallel Assignments",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/TeamRole"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "roles",
        "capabilities",
        "enabled",
        "max_parallel_assignments"
      ],
      "title": "AgentView",
      "type": "object"
    },
    "AssignmentView": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "current_stage": {
          "title": "Current Stage",
          "type": "boolean"
        },
        "planned_model": {
          "title": "Planned Model",
          "type": "string"
        },
        "planned_provider": {
          "title": "Planned Provider",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        }
      },
      "required": [
        "agent_id",
        "role",
        "planned_provider",
        "planned_model",
        "current_stage"
      ],
      "title": "AssignmentView",
      "type": "object"
    },
    "DialogueAttachmentView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "source_bytes": {
          "title": "Source Bytes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "media_type",
        "source_bytes",
        "sha256"
      ],
      "title": "DialogueAttachmentView",
      "type": "object"
    },
    "DialogueTurnView": {
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DialogueAttachmentView"
          },
          "title": "Attachments",
          "type": "array"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "speaker": {
          "enum": [
            "user",
            "product"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "speaker"
      ],
      "title": "DialogueTurnView",
      "type": "object"
    },
    "DocumentView": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "source_uri": {
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source_uri",
        "sha256"
      ],
      "title": "DocumentView",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ProjectView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "repository_count": {
          "default": 0,
          "title": "Repository Count",
          "type": "integer"
        },
        "requirement_count": {
          "default": 0,
          "title": "Requirement Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectView",
      "type": "object"
    },
    "ProjectionEventKind": {
      "description": "Source fact types rendered in a timeline.",
      "enum": [
        "state_event",
        "evaluation_event",
        "artifact",
        "evidence",
        "handoff",
        "assignment",
        "lease"
      ],
      "title": "ProjectionEventKind",
      "type": "string"
    },
    "RequestView": {
      "additionalProperties": false,
      "properties": {
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        },
        "checkpoint_sha256": {
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "dialogue": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DialogueTurnView"
          },
          "title": "Dialogue",
          "type": "array"
        },
        "documents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DocumentView"
          },
          "title": "Documents",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "next_action": {
          "title": "Next Action",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/ScopeView"
          },
          "title": "Scopes",
          "type": "array"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "title",
        "stage",
        "scopes",
        "next_action",
        "checkpoint_sha256"
      ],
      "title": "RequestView",
      "type": "object"
    },
    "RoleQueueView": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "heartbeat_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heartbeat At"
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Expires At"
        },
        "lease_liveness": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "LEASE_VALID",
            "LEASE_EXPIRED"
          ],
          "title": "Lease Liveness",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "status": {
          "$ref": "#/$defs/WorkItemStatus"
        },
        "wait_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Reason"
        },
        "work_item_id": {
          "title": "Work Item Id",
          "type": "string"
        }
      },
      "required": [
        "work_item_id",
        "role",
        "attempt",
        "status"
      ],
      "title": "RoleQueueView",
      "type": "object"
    },
    "RunView": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "route_index": {
          "title": "Route Index",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "source_uri": {
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "role",
        "provider",
        "model",
        "route_index",
        "outcome",
        "duration_ms",
        "completed_at",
        "source_uri",
        "sha256"
      ],
      "title": "RunView",
      "type": "object"
    },
    "ScopeView": {
      "additionalProperties": false,
      "properties": {
        "delivery_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Id"
        },
        "reference_only": {
          "default": false,
          "title": "Reference Only",
          "type": "boolean"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "selected_paths": {
          "items": {
            "type": "string"
          },
          "title": "Selected Paths",
          "type": "array"
        }
      },
      "required": [
        "root",
        "selected_paths"
      ],
      "title": "ScopeView",
      "type": "object"
    },
    "TaskView": {
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssignmentView"
          },
          "title": "Assignments",
          "type": "array"
        },
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        },
        "candidate_branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Branch"
        },
        "candidate_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Revision"
        },
        "checkpoint_stage": {
          "title": "Checkpoint Stage",
          "type": "string"
        },
        "documents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DocumentView"
          },
          "title": "Documents",
          "type": "array"
        },
        "execution_liveness": {
          "const": "UNKNOWN",
          "default": "UNKNOWN",
          "title": "Execution Liveness",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "last_activity": {
          "format": "date-time",
          "title": "Last Activity",
          "type": "string"
        },
        "next_action": {
          "title": "Next Action",
          "type": "string"
        },
        "plan_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Sha256"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "role_queue": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RoleQueueView"
          },
          "title": "Role Queue",
          "type": "array"
        },
        "runs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RunView"
          },
          "title": "Runs",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/ScopeView"
        },
        "source_delivery_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Delivery Id"
        },
        "source_task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Task Id"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "terminal": {
          "title": "Terminal",
          "type": "boolean"
        },
        "timeline": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TimelineEntry"
          },
          "title": "Timeline",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "work_kind": {
          "default": "delivery",
          "enum": [
            "delivery",
            "candidate_verification",
            "remediation"
          ],
          "title": "Work Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "request_id",
        "title",
        "scope",
        "status",
        "checkpoint_stage",
        "terminal",
        "last_activity",
        "next_action"
      ],
      "title": "TaskView",
      "type": "object"
    },
    "TeamRole": {
      "description": "Long-lived roles that a Team-owned AgentProfile may declare.",
      "enum": [
        "manager",
        "product",
        "designer",
        "planner",
        "coder",
        "qa",
        "reviewer"
      ],
      "title": "TeamRole",
      "type": "string"
    },
    "TimelineEntry": {
      "additionalProperties": false,
      "description": "A small, source-addressable timeline item.",
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProjectionEventKind"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^run_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "id",
        "kind",
        "occurred_at",
        "summary",
        "source_uri"
      ],
      "title": "TimelineEntry",
      "type": "object"
    },
    "WorkItemStatus": {
      "enum": [
        "READY",
        "LEASED",
        "RUNNING",
        "WAITING_HUMAN",
        "WAITING_DEPENDENCY",
        "RETRY_SCHEDULED",
        "CLOSED"
      ],
      "title": "WorkItemStatus",
      "type": "string"
    }
  },
  "$id": "https://ai-software-engineer.local/schemas/team-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AgentView"
      },
      "title": "Agents",
      "type": "array"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "projects": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProjectView"
      },
      "title": "Projects",
      "type": "array"
    },
    "requests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RequestView"
      },
      "title": "Requests",
      "type": "array"
    },
    "schema_version": {
      "const": "v0.2",
      "default": "v0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Project Id"
    },
    "tasks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskView"
      },
      "title": "Tasks",
      "type": "array"
    },
    "team_id": {
      "title": "Team Id",
      "type": "string"
    },
    "team_name": {
      "title": "Team Name",
      "type": "string"
    }
  },
  "required": [
    "as_of",
    "team_id",
    "team_name"
  ],
  "title": "TeamSnapshot",
  "type": "object"
}
