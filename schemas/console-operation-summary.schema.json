{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ase.local/schemas/console-operation-summary.schema.json",
  "$defs": {
    "ConsoleAction": {
      "enum": [
        "CREATE_PROJECT",
        "CREATE_REQUIREMENT",
        "UPDATE_REQUIREMENT",
        "CLOSE_REQUIREMENT",
        "RESTART_REQUIREMENT",
        "DELETE_REQUIREMENT",
        "PRODUCT_REPLY",
        "PRODUCT_APPROVAL",
        "CONTINUE_DELIVERY",
        "RECOVER_DESIGN",
        "RECHECK_DESIGN",
        "INSPECT_DELIVERY_WAIT",
        "HANDLE_DELIVERY_WAIT",
        "RESOLVE_DELIVERY_WAIT",
        "PROPOSE_EXECUTION_BASELINE",
        "EXECUTE_EXECUTION_BASELINE",
        "RESUME_EXECUTION_BASELINE"
      ],
      "title": "ConsoleAction",
      "type": "string"
    },
    "ConsoleOperationStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "INTERRUPTED"
      ],
      "title": "ConsoleOperationStatus",
      "type": "string"
    },
    "SubmittedApprovalKind": {
      "enum": [
        "plan",
        "scope",
        "repair"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Short reading text and identities, never an approval or command input.",
  "properties": {
    "operation_id": {
      "pattern": "^operation_[a-f0-9]{32}$",
      "title": "Operation Id",
      "type": "string"
    },
    "team_id": {
      "pattern": "^team_[a-z0-9][a-z0-9_-]{1,63}$",
      "title": "Team Id",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^project_[a-z0-9][a-z0-9_-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "delivery_id": {
      "anyOf": [
        {
          "pattern": "^delivery_[a-z0-9][a-z0-9_-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivery Id"
    },
    "action": {
      "$ref": "#/$defs/ConsoleAction"
    },
    "status": {
      "$ref": "#/$defs/ConsoleOperationStatus"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "operation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Operation Sha256",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "error_summary": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Summary"
    },
    "result_stage": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Stage"
    },
    "result_checkpoint_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Checkpoint Sha256"
    },
    "intent_checkpoint_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent Checkpoint Sha256"
    },
    "submitted_approval_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted Approval Sha256"
    },
    "submitted_approval_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubmittedApprovalKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "intent_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent Plan Sha256"
    },
    "task_id": {
      "anyOf": [
        {
          "pattern": "^task_[a-z0-9][a-z0-9_-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "work_item_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Item Id"
    },
    "approval_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Plan Sha256"
    },
    "baseline_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Plan Sha256"
    },
    "baseline_purpose": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Purpose"
    },
    "has_baseline_binding": {
      "default": false,
      "title": "Has Baseline Binding",
      "type": "boolean"
    },
    "next_step": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Step"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "approval_kind": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Kind"
    },
    "has_details": {
      "const": true,
      "default": true,
      "title": "Has Details",
      "type": "boolean"
    }
  },
  "required": [
    "operation_id",
    "team_id",
    "action",
    "status",
    "sequence",
    "requested_at",
    "updated_at",
    "operation_sha256"
  ],
  "title": "OperationSummary",
  "type": "object"
}
