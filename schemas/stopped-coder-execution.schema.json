    "NativeProcessStop": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "completed"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "returncode": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "failed"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "returncode": {
                "not": {
                  "const": 0
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "service_pause"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "session_proof": {
                "type": "object"
              }
            },
            "required": [
              "session_proof"
            ]
          }
        }
      ],
      "description": "Legacy leader/group stop, optionally with a new explicit owned-SID proof.",
      "properties": {
        "process_id": {
          "exclusiveMinimum": 0,
